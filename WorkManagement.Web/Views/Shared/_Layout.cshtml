<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkManagement.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorkManagement.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>


    @{
        var isAdmin = User.IsInRole("1");
        var isManager = User.IsInRole("2");
        var isUser = User.IsInRole("3");
        var canManage = isAdmin || isManager;

        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        var avatarUrl = Context.Items["AvatarUrl"]?.ToString();
        var FullName = Context.Items["FullName"]?.ToString();
    }

    <div class="sidebar">
        <div class="logo">
            <a href="/Home/Index">
                <div class="logo-icon">
                    <span>W</span>
                </div>
                <span class="logo-name">Work Management</span>
            </a>
        </div>
        <ul class="menu">
            <li class="nav-label">Main</li>
            <li>
                <a href="/Home/Index" class="menu-link @(ctrl == "Home" && action == "Index" ? "active" : "")">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="1" y="1" width="6" height="6" rx="1.5" />
                        <rect x="9" y="1" width="6" height="6" rx="1.5" />
                        <rect x="1" y="9" width="6" height="6" rx="1.5" />
                        <rect x="9" y="9" width="6" height="6" rx="1.5" />
                    </svg>
                    Trang chủ
                </a>
            </li>
            <li>
                <a href="/Tasks/Index" class="menu-link @(ctrl == "Tasks" ? "active" : "")">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="1" y="1" width="14" height="14" rx="2" />
                        <line x1="1" y1="5" x2="15" y2="5" />
                        <line x1="5" y1="1" x2="5" y2="5" />
                        <line x1="11" y1="1" x2="11" y2="5" />
                        <line x1="4" y1="9" x2="7" y2="9" />
                        <line x1="4" y1="12" x2="9" y2="12" />
                    </svg>
                    Công việc
                </a>
            </li>
            <li>
                <a href="/Home/Notifications" class="menu-link @(ctrl == "Home" && action == "Notifications" ? "active" : "")">
                    <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M8 1.5A4 4 0 0 0 4 5.5v3L2.5 11h11L12 8.5v-3A4 4 0 0 0 8 1.5z" />
                        <path d="M6.5 11.5a1.5 1.5 0 0 0 3 0" />
                    </svg>
                    Thông báo
                </a>
            </li>

            @if (canManage)
            {
                <li class="nav-label" style="margin-top:8px;">Quản lý</li>

                @if (isAdmin)
                {
                    <li>
                        <a href="/Users/Index" class="menu-link @(ctrl == "AdminUsers" ? "active" : "")">
                            <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                                <circle cx="6" cy="5" r="3" />
                                <path d="M1 14c0-3 2-5 5-5s5 2 5 5" />
                                <path d="M12 7l1.5 1.5L16 6" />
                            </svg>
                            Người dùng
                        </a>
                    </li>
                }

                <li>
                    <a href="/Stats/Index" class="menu-link @(ctrl == "Stats" ? "active" : "")">
                        <svg class="nav-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                            <polyline points="1,12 5,7 8,9 12,4 15,6" />
                            <line x1="1" y1="15" x2="15" y2="15" />
                        </svg>
                        Thống kê
                    </a>
                </li>
            }
        </ul>

        <form asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="logout">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M6 2H2v12h4M11 5l3 3-3 3M14 8H6" />
                </svg>
                Đăng xuất
            </button>
        </form>
    </div>
    <div class="main-content">
        <div class="topbar">
            <div class="">
            </div>
            <div class="topbar-actions">
                @if (canManage)
                {
                    <button class="add-new-btn" onclick="window.location.href='/Tasks/create'">+ Tạo việc mới</button>
                }
                <div class="notif-bell-wrapper" id="notifBellWrapper">
                    <button class="notif-bell-btn" id="notifBellBtn" title="Thông báo">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <span class="notif-badge" id="notifBadge" style="display:none">0</span>
                    </button>

                    <div class="notif-dropdown" id="notifDropdown" style="display:none">
                        <div class="notif-dropdown-header">
                            <span>Thông báo</span>
                            <a href="/Home/Notifications" class="notif-view-all">Xem tất cả</a>
                        </div>
                        <div class="notif-list" id="notifList">
                            <div class="notif-loading">Đang tải...</div>
                        </div>
                    </div>
                </div>
                <a href="/Profile/Index" style="text-decoration:none;" title="Hồ sơ cá nhân">
                    @if (string.IsNullOrEmpty(avatarUrl))
                    {
                        <div class="profile-avatar-header" id="avatar-placeholder" style="width:34px;height:34px;border-radius:50%;object-fit:cover;
                border:2px solid @(ctrl == "Profile" ? "#4f46e5" : "#e5e7eb");cursor:pointer;">
                            @FullName?.Substring(0, 1).ToUpper()
                        </div>
                    }
                    else
                    {
                        <img src="@(avatarUrl)"
                             style="width:34px;height:34px;border-radius:50%;object-fit:cover;
                border:2px solid @(ctrl == "Profile" ? "#4f46e5" : "#e5e7eb");cursor:pointer;" />
                    }

                </a>

            </div>
        </div>
        <main role="main" class="pb-3" style="flex:1; overflow-y:auto; min-height:0;padding: 20px 20px 20px;">
            @RenderBody()

        </main>
    </div>
    <div class="alert-toast-wrap" id="alertToastWrap"></div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WorkManagement.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <div class="alert-toast-wrap" id="alertToastWrap"></div>

    <script>
        function showAlert(type, message) {
            const icons = {
                success: `<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>`,
                error:   `<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`,
                warning: `<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
                info:    `<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`
            };
            const titles = {
                success: 'Thành công',
                error:   'Lỗi',
                warning: 'Cảnh báo',
                info:    'Thông tin'
            };

            const toast = document.createElement('div');
            toast.className = `alert-toast alert-toast--${type}`;
            toast.innerHTML = `
                <div class="alert-toast__icon">${icons[type]}</div>
                <div class="alert-toast__content">
                    <span class="alert-toast__title">${titles[type]}:</span>
                    <span class="alert-toast__msg"> ${message}</span>
                </div>
                <button class="alert-toast__close" onclick="this.closest('.alert-toast').remove()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>`;

            document.getElementById('alertToastWrap').appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        // Tự động hiện nếu có TempData từ server
        @if (TempData["Toast"] != null)
        {
            <text>showAlert('success', '@Html.Raw(TempData["Toast"].ToString()?.Replace("'", "\\'"))');</text>
        }
        @if (TempData["ToastError"] != null)
        {
            <text>showAlert('error', '@Html.Raw(TempData["ToastError"].ToString()?.Replace("'", "\\'"))');</text>
        }
        @if (TempData["ToastWarning"] != null)
        {
            <text>showAlert('warning', '@Html.Raw(TempData["ToastWarning"].ToString()?.Replace("'", "\\'"))');</text>
        }
        @if (TempData["ToastInfo"] != null)
        {
            <text>showAlert('info', '@Html.Raw(TempData["ToastInfo"].ToString()?.Replace("'", "\\'"))');</text>
        }
    </script>
    <script>
        (function () {
            const btn       = document.getElementById('notifBellBtn');
            const dropdown  = document.getElementById('notifDropdown');
            const list      = document.getElementById('notifList');
            const badge     = document.getElementById('notifBadge');
            let loaded      = false;

            // Toggle dropdown
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                const isOpen = dropdown.style.display === 'block';
                dropdown.style.display = isOpen ? 'none' : 'block';
                if (!isOpen && !loaded) loadNotifications();
            });

            // Đóng khi click ra ngoài
            document.addEventListener('click', function (e) {
                if (!document.getElementById('notifBellWrapper').contains(e.target)) {
                    dropdown.style.display = 'none';
                }
            });

            function timeAgo(dateStr) {
                const diff = Math.floor((Date.now() - new Date(dateStr)) / 1000);
                if (diff < 60)     return 'Vừa xong';
                if (diff < 3600)   return Math.floor(diff / 60) + ' phút trước';
                if (diff < 86400)  return Math.floor(diff / 3600) + ' giờ trước';
                return Math.floor(diff / 86400) + ' ngày trước';
            }

            function loadNotifications() {
                fetch('/Home/GetRecentNotifications', {
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
                })
                .then(r => r.json())
                .then(data => {
                    loaded = true;
                    const unread = data.filter(n => !n.isRead).length;
                    updateBadge(unread);
                    // Cập nhật badge
                    if (unread > 0) {
                        badge.textContent = unread > 9 ? '9+' : unread;
                        badge.style.display = 'flex';
                    } else {
                        badge.style.display = 'none';
                    }

                    // Render items
                    if (data.length === 0) {
                        list.innerHTML = '<div class="notif-empty">Không có thông báo nào</div>';
                        return;
                    }

                    list.innerHTML = data.map(n => `
                    <div class="notif-item ${n.isRead ? '' : 'unread'}"
                         data-id="${n.id}"
                         data-task-id="${n.taskId ?? ''}"
                         onclick="handleNotifClick(this)">
                        <div class="notif-item-dot" style="${n.isRead ? 'visibility:hidden' : ''}"></div>
                        <div class="notif-item-body">
                            <div class="notif-item-title">${escapeHtml(n.title)}</div>
                            <div class="notif-item-time">${timeAgo(n.createdAt)}</div>
                        </div>
                    </div>
                `).join('');
                })
                .catch(() => {
                    list.innerHTML = '<div class="notif-empty">Không thể tải thông báo</div>';
                });
            }

            window.handleNotifClick = function (el) {
                const notifId = el.dataset.id;
                const taskId  = el.dataset.taskId;

                // Mark đã đọc
                fetch('/Home/MarkRead', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ id: parseInt(notifId) })
                }).finally(() => {
                    dropdown.style.display = 'none';
                    if (taskId) {
                        window.location.href = `/Tasks/${taskId}/Edit`;
                    }
                });
            };

            function escapeHtml(str) {
                return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
            }
            function updateBadge(unread) {
            if (unread > 0) {
                badge.textContent = unread > 9 ? '9+' : unread;
                badge.style.display = 'flex';
                badge.classList.add('has-unread');       // ← thêm
            } else {
                badge.style.display = 'none';
                badge.classList.remove('has-unread');    // ← xóa
            }
        }
            // Load badge count khi page load (không mở dropdown)
            fetch('/Home/GetRecentNotifications')
                .then(r => r.json())
                .then(data => {
                    const unread = data.filter(n => !n.isRead).length;
                    updateBadge(unread);
                    if (unread > 0) {
                        badge.textContent = unread > 9 ? '9+' : unread;
                        badge.style.display = 'flex';
                    }
                })
                .catch(() => {});
        })();
    </script>
</body>
</html>

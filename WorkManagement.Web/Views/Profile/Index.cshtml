@model WorkManagement.Core.DTOs.User.UserDto
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roleLabel = Model.Role == 1 ? "Admin" : Model.Role == 2 ? "Manager" : "Nhân viên";
    var roleText = Model.Role == 1 ? "Quản trị viên" : Model.Role == 2 ? "Quản lý" : "Nhân viên";
}
<link rel="stylesheet" href="~/css/Profile/Index.css" />

<div class="cf-header-row">
    <div class="cf-heading">
        <h1>Hồ sơ cá nhân</h1>
        <p><span>Cập nhật thông tin và ảnh đại diện</span></p>
    </div>
</div>

<form asp-controller="Profile" asp-action="Update" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="profile-wrap">
        <!-- Avatar card -->
        <div class="profile-avatar-card">
            <div class="profile-avatar-wrap">
                @if (string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <div class="profile-avatar-placeholder" id="avatar-placeholder">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                }
                <img id="avatar-preview"
                     src="@Model.AvatarUrl"
                     class="profile-avatar-img"
                     style="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "display:none;" : "")" />
                <label for="avatar-input" class="profile-avatar-edit" title="Đổi ảnh">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z" />
                    </svg>
                </label>
                <input type="file" id="avatar-input" name="avatar"
                       accept=".jpg,.jpeg,.png,.webp"
                       style="display:none;" onchange="previewAvatar(this)" />
            </div>

            <div style="text-align:center;">
                <div class="profile-name">@Model.FullName</div>
                <div style="margin-top:6px;">
                    <span class="profile-role-badge">@roleLabel</span>
                </div>
            </div>

            <div class="profile-divider"></div>

            <div class="profile-meta">
                <div class="profile-meta-item">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    @roleText
                </div>
                <div class="profile-meta-item">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    Tham gia @Model.CreatedAt.ToString("dd/MM/yyyy")
                </div>
                @if (Model.LastLoginAt.HasValue)
                {
                    <div class="profile-meta-item">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 6v6l4 2" />
                        </svg>
                        @Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")
                    </div>
                }
            </div>

            <div class="profile-divider"></div>
            <div class="profile-avatar-hint">JPG, PNG, WEBP · Tối đa 2MB</div>
        </div>

        <!-- Info card -->
        <div class="profile-info-card">
            <div class="cf-card-section">
                <div class="cf-section-label">Thông tin cơ bản</div>
                <div class="cf-field">
                    <label class="cf-label">Họ và tên <span class="cf-req">*</span></label>
                    <input type="text" name="FullName" value="@Model.FullName"
                           class="cf-input" placeholder="Nhập họ và tên"
                           required maxlength="100" />
                </div>
                <div class="cf-field">
                    <label class="cf-label">Email <span class="cf-req">*</span></label>
                    <input type="email" name="Email" value="@Model.Email"
                           class="cf-input" placeholder="Nhập email" required />
                </div>
            </div>

            <div class="cf-card-section">
                <div class="cf-section-label">Thông tin tài khoản</div>
                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Vai trò</label>
                        <input type="text" class="cf-input profile-readonly-input"
                               value="@roleText" readonly />
                    </div>
                    <div class="cf-field">
                        <label class="cf-label">Trạng thái</label>
                        <input type="text" class="cf-input profile-readonly-input"
                               value="@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")" readonly />
                    </div>
                </div>
            </div>

            <div class="profile-footer">
                <button type="submit" class="cf-btn-submit">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                        <polyline points="17 21 17 13 7 13 7 21" />
                    </svg>
                    Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function previewAvatar(input) {
            if (!input.files || !input.files[0]) return;
            const reader = new FileReader();
            reader.onload = e => {
                const preview = document.getElementById('avatar-preview');
                const placeholder = document.getElementById('avatar-placeholder');
                preview.src = e.target.result;
                preview.style.display = 'block';
                if (placeholder) placeholder.style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    </script>
}
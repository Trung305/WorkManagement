@model WorkManagement.Web.Models.Task.TaskFormViewModel
@{
    ViewData["Title"] = "Chi tiết công việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool canEdit = User.IsInRole("1") || User.IsInRole("2");
    var statusLabels = new[] { "Chờ xử lý", "Đang làm", "Chờ duyệt", "Hoàn thành", "Từ chối" };
}

<style>
    /* ── Page ── */
    .cf-page {
    padding: 28px 32px 64px;
    max-width: 1100px;
    margin: 0 auto;
    }

    .cf-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #6b7280;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
    margin-bottom: 20px;
    transition: background .15s, color .15s;
    }

    .cf-back:hover {
    background: #f3f4f6;
    color: #111827;
    }

    /* ── Header row ── */
    .cf-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    }

    .cf-heading h1 {
    font-size: 20px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 2px;
    letter-spacing: -0.3px;
    }

    .cf-heading p {
    font-size: 13px;
    color: #6b7280;
    margin: 0;
    }

    .cf-header-btns {
    display: flex;
    gap: 10px;
    }

    .cf-btn-cancel {
    padding: 8px 18px;
    border-radius: 8px;
    border: 0.5px solid #e5e7eb;
    background: #fff;
    font-size: 13.5px;
    font-weight: 500;
    color: #374151;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: background .15s;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    }

    .cf-btn-cancel:hover {
    background: #f3f4f6;
    }

    .cf-btn-submit {
    padding: 8px 20px;
    border-radius: 8px;
    border: none;
    background: #4f46e5;
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background .15s, transform .1s;
    font-family: 'DM Sans', sans-serif;
    }

    .cf-btn-submit:hover {
    background: #4338ca;
    }

    .cf-btn-submit:active {
    transform: scale(0.98);
    }

    .cf-btn-save {
    padding: 8px 18px;
    border-radius: 8px;
    border: 0.5px solid #e5e7eb;
    background: #fff;
    font-size: 13.5px;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background .15s;
    font-family: 'DM Sans', sans-serif;
    }

    .cf-btn-save:hover {
    background: #f3f4f6;
    }

    .cf-btn-green {
    padding: 8px 20px;
    border-radius: 8px;
    border: none;
    background: #16a34a;
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background .15s;
    font-family: 'DM Sans', sans-serif;
    }

    .cf-btn-green:hover {
    background: #15803d;
    }
    /* ── 2-col layout ── */
    .cf-body {
    grid-template-columns: 300px 1fr;
    gap: 20px;
    align-items: start;
    margin-bottom: 48px;
    }

    .cf-col-left {
    position: sticky;
    top: 24px; 
    }
    /* ── Card chung ── */
    .cf-card {
    background: #fff;
    border: 0.5px solid #e5e7eb;
    border-radius: 14px;
    overflow: hidden;
    }

    .cf-card-section {
    padding: 20px 22px;
    }

    .cf-card-section + .cf-card-section {
    border-top: 0.5px solid #f3f4f6;
    }

    .cf-section-label {
    font-size: 11px;
    font-weight: 600;
    color: #9ca3af;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 14px;
    }

    /* ── Upload card ── */
    .cf-drop-zone {
    border: 1.5px dashed #d1d5db;
    border-radius: 10px;
    padding: 28px 16px;
    text-align: center;
    cursor: pointer;
    transition: border-color .15s, background .15s;
    background: #fafafa;
    }

    .cf-drop-zone:hover, .cf-drop-zone.dragover {
    border-color: #4f46e5;
    background: #f5f3ff;
    }

    .cf-drop-zone svg {
    color: #9ca3af;
    margin-bottom: 10px;
    }

    .cf-drop-zone p {
    font-size: 13px;
    color: #6b7280;
    margin: 0;
    line-height: 1.6;
    }

    .cf-drop-zone span {
    color: #4f46e5;
    font-weight: 600;
    cursor: pointer;
    }

    .cf-drop-input {
    display: none;
    }

    /* File list */
    .cf-file-list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    }

    .cf-file-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    background: #f9fafb;
    border: 0.5px solid #e5e7eb;
    border-radius: 8px;
    }

    .cf-file-icon {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: #4f46e5;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    font-family: 'DM Mono', monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    }

    .cf-file-icon--img {
    background: #0891b2;
    }

    .cf-file-icon--pdf {
    background: #dc2626;
    }

    .cf-file-info {
    flex: 1;
    min-width: 0;
    }

    .cf-file-name {
    font-size: 12.5px;
    font-weight: 600;
    color: #111827;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    }

    .cf-file-size {
    font-size: 11px;
    color: #9ca3af;
    font-family: 'DM Mono', monospace;
    }

    .cf-file-remove {
    background: none;
    border: none;
    cursor: pointer;
    color: #9ca3af;
    padding: 2px;
    display: flex;
    align-items: center;
    transition: color .15s;
    flex-shrink: 0;
    }

    .cf-file-remove:hover {
    color: #ef4444;
    }

    /* ── Form card ── */
    .cf-field {
    margin-bottom: 15px;
    }

    .cf-field:last-child {
    margin-bottom: 0;
    }

    .cf-label {
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 6px;
    }

    .cf-req {
    color: #ef4444;
    margin-left: 2px;
    }

    .cf-input, .cf-select, .cf-textarea {
    width: 100%;
    background: #fafafa;
    border: 0.5px solid #e5e7eb;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 13.5px;
    font-family: 'DM Sans', sans-serif;
    color: #111827;
    outline: none;
    transition: border-color .15s, background .15s;
    box-sizing: border-box;
    }

    .cf-input:focus, .cf-select:focus, .cf-textarea:focus {
    border-color: #4f46e5;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(79,70,229,0.08);
    }

    .cf-textarea {
    resize: vertical;
    min-height: 96px;
    line-height: 1.6;
    }

    .cf-field-err {
    font-size: 12px;
    color: #ef4444;
    margin-top: 4px;
    display: block;
    }

    .cf-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    }

    /* Priority pills */
    .cf-priority-group {
    display: flex;
    gap: 8px;
    }

    .cf-priority-pill {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 8px 10px;
    border-radius: 8px;
    border: 1.5px solid #e5e7eb;
    background: #fafafa;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all .15s;
    position: relative;
    white-space: nowrap;
    }

    .cf-priority-pill input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    }

    .cf-priority-pill:has(input:checked) {
    border-width: 1.5px;
    }

    .cf-priority-pill--low:has(input:checked) {
    background: #eaf3de;
    border-color: #3b6d11;
    color: #3b6d11;
    }

    .cf-priority-pill--medium:has(input:checked) {
    background: #faeeda;
    border-color: #854f0b;
    color: #854f0b;
    }

    .cf-priority-pill--high:has(input:checked) {
    background: #fcebeb;
    border-color: #a32d2d;
    color: #a32d2d;
    }

    /* Alert */
    .cf-alert {
    margin-bottom: 14px;
    padding: 11px 14px;
    background: #fef2f2;
    border: 0.5px solid #fecaca;
    border-radius: 8px;
    font-size: 13px;
    color: #991b1b;
    }

    .um-btn-green {
    padding: 8px 18px;
    border-radius: 8px;
    border: none;
    background: #16a34a;
    font-size: 13.5px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background .15s;
    font-family: 'DM Sans', sans-serif;
    }

    .um-btn-green:hover {
    background: #15803d;
    }

    .um-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(17,24,39,0.4);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
    }
    .um-overlay.open { display: flex; }

    .um-modal {
    background: #fff;
    border-radius: 14px;
    width: 100%;
    max-width: 520px;
    margin: 16px;
    box-shadow: 0 24px 64px rgba(0,0,0,0.14);
    animation: umIn .2s ease;
    }
    .um-modal-sm { max-width: 400px; }

    @@keyframes umIn {
    from { opacity: 0; transform: translateY(-12px) scale(.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .um-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px 0;
    }
    .um-modal-title { font-size: 17px; font-weight: 700; color: #111827; margin: 0; }
    .um-modal-close {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #9ca3af;
    padding: 4px;
    border-radius: 6px;
    display: flex;
    transition: all .15s;
    }
    .um-modal-close:hover { background: #f3f4f6; color: #374151; }

    .um-modal-body   { padding: 20px 24px; }
    .um-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 16px 24px 20px;
    border-top: 0.5px solid #f3f4f6;
    }

    .um-delete-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    padding-top: 8px;
    }
    .um-delete-icon {
    width: 56px;
    height: 56px;
    background: #dcfce7;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    }
    .um-delete-text { font-size: 14px; color: #374151; line-height: 1.7; margin: 0; }

    .um-btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 8px;
    background: transparent;
    color: #374151;
    font-size: 14px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    border: 0.5px solid #e5e7eb;
    cursor: pointer;
    transition: background .15s;
    }
    .um-btn-ghost:hover { background: #f3f4f6; }

    .um-btn-green {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    border-radius: 8px;
    background: #16a34a;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    font-family: 'DM Sans', sans-serif;
    border: none;
    cursor: pointer;
    transition: background .15s;
    }
    .um-btn-green:hover { background: #15803d; }
</style>

<div class="cf-header-row">
    <div class="cf-heading">
        <h1>@(canEdit ? "Chỉnh sửa công việc" : "Chi tiết công việc")</h1>
        <p>
            @if (canEdit)
            {
                <span>Cập nhật thông tin và phân công</span>
            }
            else
            {
                <span>Xem và cập nhật tiến độ công việc</span>
            }
        </p>
    </div>
    <div class="cf-header-btns">
        <a href="@Url.Action("Index")" class="cf-btn-cancel">← Quay lại</a>

        @if (canEdit)
        {
            @if (Model.Status == 3) 
            {
                <button type="button" class="cf-btn-green" onclick="openReviewModal()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                    Đánh giá
                </button>
            }
            @if (Model.Status == 1 || Model.Status == 2)
            {
                <button type="button" class="cf-btn-submit" onclick="saveTask()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                        <polyline points="17 21 17 13 7 13 7 21" />
                    </svg>
                    Cập nhật
                </button>
            }
        }
        else
        {
            @if (Model.Status == 1 || Model.Status == 2)
            {
                <button type="button" class="cf-btn-save" onclick="saveTask()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                        <polyline points="17 21 17 13 7 13 7 21" />
                    </svg>
                    Lưu
                </button>
                <button type="button" class="cf-btn-green" onclick="submitTask()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                    Gửi đánh giá
                </button>
            }
        }
    </div>
</div>

@if (!canEdit)
{
    @Html.AntiForgeryToken()
}

<div class="cf-body" style="@((Model.Status != 3 && Model.Status != 4) ? "display: grid;" : "")">
    <div class="cf-card" style="@((Model.Status == 3 || Model.Status == 4) ? "display: none;" : "")">
        <div class="cf-card-section">
            @if (Model.Status != 3 && Model.Status != 4)
            {

                if (Model.Status == 5 && !string.IsNullOrEmpty(Model.RejectedReason))
                {
                    <div class="cf-card">
                        <div class="cf-card-section">
                            <div class="cf-section-label">Lý do từ chối</div>
                            <div style="background:#fef2f2;border:0.5px solid #fecaca;border-radius:10px;padding:14px 16px;">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                                    <div style="width:32px;height:32px;border-radius:50%;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <svg width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2" viewBox="0 0 24 24">
                                            <circle cx="12" cy="12" r="10" />
                                            <line x1="15" y1="9" x2="9" y2="15" />
                                            <line x1="9" y1="9" x2="15" y2="15" />
                                        </svg>
                                    </div>
                                    <span style="font-size:13px;font-weight:600;color:#991b1b;">Công việc bị từ chối</span>
                                </div>
                                <p style="font-size:13.5px;color:#7f1d1d;line-height:1.6;margin:0;white-space:pre-wrap;">@Model.RejectedReason</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="cf-section-label">Tệp đính kèm</div>
                    <div class="cf-drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
                            <polyline points="17 8 12 3 7 8" />
                            <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                        <p>
                            <span>Click để tải lên</span> hoặc kéo thả<br />
                            PNG, JPG, PDF (tối đa 5MB)
                        </p>
                    </div>
                    <input type="file" id="fileInput" name="Attachments" class="cf-drop-input"
                           multiple accept=".png,.jpg,.jpeg,.pdf,.doc,.docx,.xlsx" />

                    <div class="cf-file-list" id="fileList"></div>
                } 
    }
        </div>
    </div>

    <div class="cf-card">

        @if (canEdit)
        {
            <form id="cf-form" asp-action="Edit" asp-controller="Tasks" asp-route-id="@Model.Id"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="cf-alert"></div>

                <div class="cf-card-section">
                    <div class="cf-section-label">Thông tin cơ bản</div>
                    <div class="cf-field">
                        <label asp-for="Title" class="cf-label">Tiêu đề <span class="cf-req">*</span></label>
                        <input asp-for="Title" class="cf-input" placeholder="Mô tả ngắn gọn công việc cần làm" />
                        <span asp-validation-for="Title" class="cf-field-err"></span>
                    </div>
                    <div class="cf-field">
                        <label asp-for="Description" class="cf-label">Mô tả chi tiết</label>
                        <textarea asp-for="Description" class="cf-textarea"
                                  placeholder="Hướng dẫn, yêu cầu cụ thể..."></textarea>
                    </div>
                </div>

                <div class="cf-card-section">
                    <div class="cf-section-label">Phân loại & Phân công</div>
                    <div class="cf-row">
                        <div class="cf-field">
                            <label class="cf-label">Độ ưu tiên</label>
                            <div class="cf-priority-group">
                                <label class="cf-priority-pill cf-priority-pill--low">
                                    @if (Model.Priority == 0)
                                    {
                                        <input type="radio" asp-for="Priority" value="0" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" asp-for="Priority" value="0" />
                                    }
                                    🟢 Thấp
                                </label>
                                <label class="cf-priority-pill cf-priority-pill--medium">
                                    @if (Model.Priority == 1)
                                    {
                                        <input type="radio" asp-for="Priority" value="1" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" asp-for="Priority" value="1" />
                                    }
                                    🟡 TB
                                </label>
                                <label class="cf-priority-pill cf-priority-pill--high">
                                    @if (Model.Priority == 2)
                                    {
                                        <input type="radio" asp-for="Priority" value="2" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" asp-for="Priority" value="2" />
                                    }
                                    🔴 Cao
                                </label>
                            </div>
                        </div>
                        <div class="cf-field">
                            <label asp-for="AssignedToId" class="cf-label">Giao cho <span class="cf-req">*</span></label>
                            <select asp-for="AssignedToId" class="cf-select">
                                <option value="">— Chưa phân công —</option>
                                @foreach (var u in Model.AssignableUsers)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="AssignedToId" class="cf-field-err"></span>
                        </div>
                    </div>
                </div>

                <div class="cf-card-section">
                    <div class="cf-section-label">Thời gian</div>
                    <div class="cf-row">
                        <div class="cf-field">
                            <label asp-for="StartDate" class="cf-label">Ngày bắt đầu</label>
                            <input asp-for="StartDate" type="date" class="cf-input" />
                        </div>
                        <div class="cf-field">
                            <label asp-for="Deadline" class="cf-label">Deadline</label>
                            <input asp-for="Deadline" type="date" class="cf-input" />
                        </div>
                    </div>
                </div>
            </form>
            <div class="cf-card-section">
                <div class="cf-section-label">File đính kèm</div>
                <div id="files-table-wrap">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="border-bottom:0.5px solid #e5e7eb;">
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Tên file</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Người upload</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Ngày upload</th>
                                <th style="padding:8px 12px;"></th>
                            </tr>
                        </thead>
                        <tbody id="files-table-body">
                            <tr>
                                <td colspan="4" style="padding:20px;text-align:center;color:#9ca3af;font-size:13px;">
                                    Đang tải...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="cf-card-section">
                <div class="cf-section-label">Thông tin cơ bản</div>
                <div class="cf-field">
                    <label class="cf-label">Tiêu đề</label>
                    <input type="text" class="cf-input" value="@Model.Title" readonly />
                </div>
                <div class="cf-field">
                    <label class="cf-label">Mô tả chi tiết</label>
                    <textarea class="cf-textarea" readonly>@Model.Description</textarea>
                </div>
            </div>

            <div class="cf-card-section">
                <div class="cf-section-label">Phân loại & Phân công</div>
                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Độ ưu tiên</label>
                        <div class="cf-priority-group">
                            <label class="cf-priority-pill cf-priority-pill--low cf-priority-pill--disabled">
                                @if (Model.Priority == 0)
                                {
                                    <input type="radio" checked disabled />
                                }
                                else
                                {
                                    <input type="radio" disabled />
                                }
                                🟢 Thấp
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--medium cf-priority-pill--disabled">
                                @if (Model.Priority == 1)
                                {
                                    <input type="radio" checked disabled />
                                }
                                else
                                {
                                    <input type="radio" disabled />
                                }
                                🟡 TB
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--high cf-priority-pill--disabled">
                                @if (Model.Priority == 2)
                                {
                                    <input type="radio" checked disabled />
                                }
                                else
                                {
                                    <input type="radio" disabled />
                                }
                                🔴 Cao
                            </label>
                        </div>
                    </div>
                    <div class="cf-field">
                        <label class="cf-label">Người thực hiện</label>
                        <input type="text" class="cf-input" value="@Model.AssignedToName" readonly />
                    </div>
                </div>
            </div>

            <div class="cf-card-section">
                <div class="cf-section-label">Thời gian</div>
                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Ngày bắt đầu</label>
                        <input type="text" class="cf-input"
                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy") : "—")"
                               readonly />
                    </div>
                    <div class="cf-field">
                        <label class="cf-label">Ngày hoàn tất</label>
                        <input type="text" class="cf-input"
                               value="@(Model.Deadline.HasValue ? Model.Deadline.Value.ToString("dd/MM/yyyy") : "—")"
                               readonly />
                    </div>
                </div>
            </div>

            <div class="cf-card-section">
                <div class="cf-section-label">Trạng thái</div>
                @if (!canEdit && (Model.Status == 1 || Model.Status == 2))
                {
                    <select id="status-select" class="cf-select" style="width:100%;">
                        @if (Model.Status == 1)
                        {
                            <option value="1" selected>Chờ xử lý</option>
                            <option value="2">Đang làm</option>
                        }
                        else
                        {
                            <option value="1">Chờ xử lý</option>
                            <option value="2" selected>Đang làm</option>
                        }
                    </select>

                    <form id="user-status-form" method="post" action="@Url.Action("UpdateStatus", new { id = Model.Id })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" id="user-status-input" value="@Model.Status" />
                    </form>
                }
                else
                {
                    <div>@Html.Partial("_StatusBadge", Model.Status)</div>
                }
            </div>
            <div class="cf-card-section">
                <div class="cf-section-label">File đính kèm</div>
                <div id="files-table-wrap">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="border-bottom:0.5px solid #e5e7eb;">
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Tên file</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Người upload</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Ngày upload</th>
                                <th style="padding:8px 12px;"></th>
                            </tr>
                        </thead>
                        <tbody id="files-table-body">
                            <tr>
                                <td colspan="4" style="padding:20px;text-align:center;color:#9ca3af;font-size:13px;">
                                    Đang tải...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
<!-- Modal gửi đánh giá -->
<div class="um-overlay" id="submitModal">
    <div class="um-modal um-modal-sm">
        <div class="um-modal-header">
            <h2 class="um-modal-title">Xác nhận gửi đánh giá</h2>
            <button class="um-modal-close" onclick="closeSubmitModal()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="um-modal-body um-delete-body">
            <div class="um-delete-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="9 12 11 14 15 10" />
                </svg>
            </div>
            <p class="um-delete-text">
                Gửi công việc để Manager đánh giá?<br>
                <span style="color:#9ca3af;font-size:13px">Sau khi gửi bạn sẽ không thể chỉnh sửa thêm.</span>
            </p>
        </div>
        <div class="um-modal-footer">
            <button class="um-btn-ghost" onclick="closeSubmitModal()">Hủy</button>
            <button class="um-btn-green" onclick="doSubmitTask()">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
                Gửi đánh giá
            </button>
        </div>
    </div>
</div>
<!-- Modal đánh giá -->
<div class="um-overlay" id="reviewModal">
    <div class="um-modal um-modal-sm" style="max-width:480px;">
        <div class="um-modal-header">
            <input type="hidden" id="rv-task-id" value="@Model.Id" />
            <h2 class="um-modal-title">Đánh giá công việc</h2>
            <button class="um-modal-close" onclick="closeReviewModal()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="um-modal-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
                <div id="rv-approve"
                     onclick="selectReview(true)"
                     style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
                            padding:18px 12px;border-radius:10px;border:1.5px solid #e5e7eb;
                            cursor:pointer;transition:all .15s;font-size:13.5px;font-weight:600;color:#374151;text-align:center;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    Duyệt — Hoàn thành
                </div>
                <div id="rv-reject"
                     onclick="selectReview(false)"
                     style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
                            padding:18px 12px;border-radius:10px;border:1.5px solid #e5e7eb;
                            cursor:pointer;transition:all .15s;font-size:13.5px;font-weight:600;color:#374151;text-align:center;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                    </svg>
                    Từ chối
                </div>
            </div>

            <div id="rv-reason-wrap" style="display:none;">
                <label style="font-size:12.5px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">
                    Lý do từ chối <span style="color:#ef4444;">*</span>
                </label>
                <textarea id="rv-reason" class="cf-textarea"
                          placeholder="Mô tả rõ lý do..."></textarea>
                <span id="rv-reason-err" style="font-size:12px;color:#ef4444;margin-top:4px;display:block;"></span>
            </div>
        </div>
        <div class="um-modal-footer">
            <button class="um-btn-ghost" onclick="closeReviewModal()">Hủy</button>
            <button id="rv-submit-btn" class="cf-btn-submit" onclick="doReview()" style="padding:9px 16px;">
                Xác nhận đánh giá
            </button>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const TASK_ID    = @Model.Id;
        const CAN_EDIT   = @canEdit.ToString().ToLower();
        const TASK_STATUS = @Model.Status;
        const ANTIFORGERY = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        // ── Load files khi trang load ────────────────────────
        window.addEventListener('DOMContentLoaded', () => renderFilesTable());

        async function renderFilesTable() {
            const res = await fetch(`/Tasks/${TASK_ID}/files`);
            if (!res.ok) return;
            const files = await res.json();

            const tbody = document.getElementById('files-table-body');
            if (!tbody) return;

            if (files.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" style="padding:20px;text-align:center;color:#9ca3af;font-size:13px;">
                            Chưa có file nào
                        </td>
                    </tr>`;
                return;
            }

            tbody.innerHTML = files.map(f => {
                const ext      = f.fileName.split('.').pop().toUpperCase();
                const iconCls  = getIconClass(f.fileName);
                const roleTag  = f.uploadedByRole <= 2
                    ? `<span style="font-size:11px;padding:2px 7px;border-radius:20px;background:#ede9fe;color:#5b21b6;font-weight:600;">Manager</span>`
                    : `<span style="font-size:11px;padding:2px 7px;border-radius:20px;background:#dbeafe;color:#1d4ed8;font-weight:600;">User</span>`;
                const date = new Date(f.uploadedAt).toLocaleDateString('vi-VN', {
                    day:'2-digit', month:'2-digit', year:'numeric',
                    hour:'2-digit', minute:'2-digit'
                });
                return `
                    <tr style="border-bottom:0.5px solid #f3f4f6;">
                        <td style="padding:10px 12px;">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <div class="cf-file-icon ${iconCls}" style="width:28px;height:28px;font-size:9px;flex-shrink:0;">${ext}</div>
                                <div>
                                    <div style="font-size:13px;font-weight:600;color:#111827;">${f.fileName}</div>
                                    <div style="font-size:11px;color:#9ca3af;font-family:'DM Mono',monospace;">${formatSize(f.fileSize)}</div>
                                </div>
                            </div>
                        </td>
                        <td style="padding:10px 12px;">
                            <div style="font-size:13px;color:#374151;">${f.uploadedByName}</div>
                            <div style="margin-top:3px;">${roleTag}</div>
                        </td>
                        <td style="padding:10px 12px;font-size:12.5px;color:#6b7280;font-family:'DM Mono',monospace;">${date}</td>
                        <td style="padding:10px 12px;text-align:right;">
                            <a href="/Tasks/download/${f.id}" download
                               style="display:inline-flex;align-items:center;gap:4px;font-size:12.5px;font-weight:600;color:#4f46e5;text-decoration:none;padding:5px 10px;border-radius:7px;border:0.5px solid #e5e7eb;background:#fff;transition:background .15s;"
                               onmouseover="this.style.background='#f5f3ff'" onmouseout="this.style.background='#fff'">
                                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                                    <polyline points="7 10 12 15 17 10"/>
                                    <line x1="12" y1="15" x2="12" y2="3"/>
                                </svg>
                                Tải về
                            </a>
                        </td>
                    </tr>`;
            }).join('');
        }
        function renderDlFile(f) {
            const ext = f.fileName.split('.').pop().toUpperCase();
            return `
                <a href="/Tasks/download/${f.id}" class="cf-file-dl" download>
                    <div class="cf-file-icon ${getIconClass(f.fileName)}">${ext}</div>
                    <span class="cf-file-dl-name">${f.fileName}</span>
                    <span class="cf-file-dl-size">${formatSize(f.fileSize)}</span>
                    <svg width="13" height="13" fill="none" stroke="#9ca3af" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                </a>`;
        }

        // ── Drag & drop (dùng chung cho cả Manager lẫn User) ─
        let selectedFiles = [];
        document.getElementById('submitModal').addEventListener('click', e => {
            if (e.target === e.currentTarget) closeSubmitModal();
        });
        const dropZoneEl = document.getElementById('dropZone');
        const fileInputEl = document.getElementById('fileInput');

        if (dropZoneEl && fileInputEl) {
            dropZoneEl.addEventListener('dragover',  e => { e.preventDefault(); dropZoneEl.classList.add('dragover'); });
            dropZoneEl.addEventListener('dragleave', () => dropZoneEl.classList.remove('dragover'));
            dropZoneEl.addEventListener('drop', e => {
                e.preventDefault(); dropZoneEl.classList.remove('dragover');
                addFiles(e.dataTransfer.files);
            });
            fileInputEl.addEventListener('change', () => addFiles(fileInputEl.files));
        }

        function addFiles(files) {
            Array.from(files).forEach(f => {
                if (f.size > 5 * 1024 * 1024) { alert(`File "${f.name}" vượt quá 5MB`); return; }
                if (!selectedFiles.find(x => x.name === f.name && x.size === f.size)) selectedFiles.push(f);
            });
            renderFileList();
            if (CAN_EDIT) syncFileInput(); // Manager dùng form submit bình thường
        }

        function removeFile(i) {
            selectedFiles.splice(i, 1);
            renderFileList();
            if (CAN_EDIT) syncFileInput();
        }

        function renderFileList() {
            const list = document.getElementById('fileList');
            if (!list) return;
            list.innerHTML = selectedFiles.map((f, i) => `
                <div class="cf-file-item">
                    <div class="cf-file-icon ${getIconClass(f.name)}">${f.name.split('.').pop().toUpperCase()}</div>
                    <div class="cf-file-info">
                        <div class="cf-file-name">${f.name}</div>
                        <div class="cf-file-size">${formatSize(f.size)}</div>
                    </div>
                    <button type="button" class="cf-file-remove" onclick="removeFile(${i})">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>`).join('');
        }

        function syncFileInput() {
            const dt = new DataTransfer();
            selectedFiles.forEach(f => dt.items.add(f));
            if (fileInputEl) fileInputEl.files = dt.files;
        }

        async function saveTask() {
            if (CAN_EDIT) {
                document.getElementById('cf-form').submit();
                return;
            }
            if (selectedFiles.length > 0) {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', ANTIFORGERY());
                selectedFiles.forEach(f => fd.append('files', f));
                const res = await fetch(`/Tasks/${TASK_ID}/upload`, { method: 'POST', body: fd });
                if (!res.ok) {
                    showAlert('error', await res.text() || 'Lỗi khi lưu file.');
                    return;
                }
            }
            const statusSelect = document.getElementById('status-select');
            if (statusSelect) {
                document.getElementById('user-status-input').value = statusSelect.value;
            }
            document.getElementById('user-status-form').submit();
        }
        async function doSubmitTask() {
            closeSubmitModal();
            if (selectedFiles.length > 0) {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', ANTIFORGERY());
                selectedFiles.forEach(f => fd.append('files', f));
                const upRes = await fetch(`/Tasks/${TASK_ID}/upload`, { method: 'POST', body: fd });
                if (!upRes.ok) {
                    showAlert('error', 'Lỗi khi upload file.');
                    return;
                }
            }
            const fd2 = new FormData();
            fd2.append('__RequestVerificationToken', ANTIFORGERY());
            const res = await fetch(`/Tasks/${TASK_ID}/submit`, { method: 'POST', body: fd2 });
            if (res.ok) {
                showAlert('success', 'Đã gửi đánh giá!');
                setTimeout(() => location.href = '/Tasks/Index', 800);
            } else {
                showAlert('error', await res.text() || 'Có lỗi xảy ra.');
            }
        }
        let isApprove = true;

        function selectReview(value) {
            isApprove = value;

            const approve = document.getElementById("rv-approve");
            const reject = document.getElementById("rv-reject");
            const reasonWrap = document.getElementById("rv-reason-wrap");

            // reset style
            approve.style.borderColor = "#e5e7eb";
            reject.style.borderColor = "#e5e7eb";

            if (value) {
                approve.style.borderColor = "#16a34a"; // xanh
                reasonWrap.style.display = "none";
            } else {
                reject.style.borderColor = "#ef4444"; // đỏ
                reasonWrap.style.display = "block";
            }
        }
        async function doReview() {
            const taskId = document.getElementById("rv-task-id").value;
            const reason = document.getElementById("rv-reason").value.trim();
            const err    = document.getElementById("rv-reason-err");
            const btn    = document.getElementById("rv-submit-btn");
            err.innerText = "";

            if (!isApprove && !reason) {
                err.innerText = "Vui lòng nhập lý do từ chối";
                return;
            }

            btn.disabled  = true;
            btn.innerText = "Đang xử lý...";

            try {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', ANTIFORGERY());
                fd.append('Approved', isApprove);
                fd.append('RejectedReason', reason || "");

                const res = await fetch(`/tasks/${taskId}/review`, { method: 'POST', body: fd });
                if (!res.ok) {
                    const text = await res.text();
                    throw new Error(text || "Lỗi server");
                }

                closeReviewModal();
                showAlert('success', isApprove ? "Đã duyệt công việc." : "Đã từ chối công việc.");
                setTimeout(() => location.href = "/Tasks/Index", 800);
            } catch (e) {
                err.innerText = "Không thể gửi đánh giá";
                showAlert('error', e.message || 'Có lỗi xảy ra.');
            } finally {
                btn.disabled  = false;
                btn.innerText = "Xác nhận đánh giá";
            }
        }
        // Open Modal
        function submitTask() {
            document.getElementById('submitModal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeSubmitModal() {
            document.getElementById('submitModal').classList.remove('open');
            document.body.style.overflow = '';
        }
        function openReviewModal() {
            document.getElementById("reviewModal").style.display = "flex";
        }

        function closeReviewModal() {
            document.getElementById("reviewModal").style.display = "none";
        }

        function getIconClass(name) {
            const ext = name.split('.').pop().toLowerCase();
            if (['png','jpg','jpeg','gif','webp'].includes(ext)) return 'cf-file-icon--img';
            if (ext === 'pdf') return 'cf-file-icon--pdf';
            return '';
        }

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }
    </script>
}
@model WorkManagement.Web.Models.Task.TaskFormViewModel
@{
    ViewData["Title"] = "Chi tiết công việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool canEdit = User.IsInRole("1") || User.IsInRole("2");
    var statusLabels = new[] { "Chờ xử lý", "Đang làm", "Chờ duyệt", "Hoàn thành", "Từ chối" };

}
<link rel="stylesheet" href="~/css/Tasks/Edit.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" />
<div class="cf-header-row">
    <div class="cf-heading">
        <h1>@(canEdit ? "Chỉnh sửa công việc" : "Chi tiết công việc")</h1>
        <p>
            @if (canEdit)
            {
                <span>Cập nhật thông tin và phân công</span>
            }
            else
            {
                <span>Xem và cập nhật tiến độ công việc</span>
            }
        </p>
    </div>
    <div class="cf-header-btns">
        <a href="@Url.Action("Index")" class="cf-btn-cancel">← Quay lại</a>

        @if (canEdit)
        {
            @if (Model.Status == 3) 
            {
                <button type="button" class="cf-btn-green" onclick="openReviewModal()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                    Đánh giá
                </button>
            }
            @if (Model.Status == 1 || Model.Status == 2)
            {
                <button type="button" class="cf-btn-submit" onclick="saveTask()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                        <polyline points="17 21 17 13 7 13 7 21" />
                    </svg>
                    Cập nhật
                </button>
            }
        }
        else
        {
            @if (Model.Status == 1 || Model.Status == 2)
            {
                <button type="button" class="cf-btn-save" onclick="saveTask()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                        <polyline points="17 21 17 13 7 13 7 21" />
                    </svg>
                    Lưu
                </button>
                <button type="button" class="cf-btn-green" onclick="submitTask()">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="22" y1="2" x2="11" y2="13" />
                        <polygon points="22 2 15 22 11 13 2 9 22 2" />
                    </svg>
                    Gửi đánh giá
                </button>
            }
        }
    </div>
</div>

@if (!canEdit)
{
    @Html.AntiForgeryToken()
}

<div class="cf-body" style="@((Model.Status != 3 && Model.Status != 4) ? "display: grid;" : "")">
    <div class="cf-card" style="@((Model.Status == 3 || Model.Status == 4) ? "display: none;" : "")">
        <div class="cf-card-section">
            @if (Model.Status != 3 && Model.Status != 4)
            {

                if (Model.Status == 5 && !string.IsNullOrEmpty(Model.RejectedReason))
                {
                    <div class="cf-card">
                        <div class="cf-card-section">
                            <div class="cf-section-label">Lý do từ chối</div>
                            <div style="background:#fef2f2;border:0.5px solid #fecaca;border-radius:10px;padding:14px 16px;">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                                    <div style="width:32px;height:32px;border-radius:50%;background:#fee2e2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <svg width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2" viewBox="0 0 24 24">
                                            <circle cx="12" cy="12" r="10" />
                                            <line x1="15" y1="9" x2="9" y2="15" />
                                            <line x1="9" y1="9" x2="15" y2="15" />
                                        </svg>
                                    </div>
                                    <span style="font-size:13px;font-weight:600;color:#991b1b;">Công việc bị từ chối</span>
                                </div>
                                <p style="font-size:13.5px;color:#7f1d1d;line-height:1.6;margin:0;white-space:pre-wrap;">@Model.RejectedReason</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="cf-section-label">Tệp đính kèm</div>
                    <div class="cf-drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
                            <polyline points="17 8 12 3 7 8" />
                            <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                        <p>
                            <span>Click để tải lên</span> hoặc kéo thả<br />
                            PNG, JPG, PDF (tối đa 5MB)
                        </p>
                    </div>
                    <input type="file" id="fileInput" name="Attachments" class="cf-drop-input"
                           multiple accept=".png,.jpg,.jpeg,.pdf,.doc,.docx,.xlsx" />

                    <div class="cf-file-list" id="fileList"></div>
                } 
    }
        </div>
    </div>

    <div class="cf-card">

        @if (canEdit)
        {
            <form id="cf-form" asp-action="Edit" asp-controller="Tasks" asp-route-id="@Model.Id"
                  method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="cf-alert"></div>

                <div class="cf-card-section">
                    <div class="cf-section-label">Thông tin cơ bản</div>
                    <div class="cf-field">
                        <label asp-for="Title" class="cf-label">Tiêu đề <span class="cf-req">*</span></label>
                        <input asp-for="Title" class="cf-input" placeholder="Mô tả ngắn gọn công việc cần làm" />
                        <span asp-validation-for="Title" class="cf-field-err"></span>
                    </div>
                    <div class="cf-field">
                        <label asp-for="Description" class="cf-label">Mô tả chi tiết</label>
                        <textarea asp-for="Description" class="cf-textarea"
                                  placeholder="Hướng dẫn, yêu cầu cụ thể..."></textarea>
                    </div>
                </div>

                <div class="cf-card-section">
                    <div class="cf-section-label">Phân loại & Phân công</div>
                    <div class="cf-row">
                        <div class="cf-field">
                            <label class="cf-label">Độ ưu tiên</label>
                            <div class="cf-priority-group">
                                <label class="cf-priority-pill cf-priority-pill--low">
                                    @if (Model.Priority == 0)
                                    {
                                        <input type="radio" asp-for="Priority" value="0" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" asp-for="Priority" value="0" />
                                    }
                                    🟢 Thấp
                                </label>
                                <label class="cf-priority-pill cf-priority-pill--medium">
                                    @if (Model.Priority == 1)
                                    {
                                        <input type="radio" asp-for="Priority" value="1" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" asp-for="Priority" value="1" />
                                    }
                                    🟡 TB
                                </label>
                                <label class="cf-priority-pill cf-priority-pill--high">
                                    @if (Model.Priority == 2)
                                    {
                                        <input type="radio" asp-for="Priority" value="2" checked />
                                    }
                                    else
                                    {
                                        <input type="radio" asp-for="Priority" value="2" />
                                    }
                                    🔴 Cao
                                </label>
                            </div>
                        </div>
                        <div class="cf-field">
                            <label class="cf-label">Giao cho <span class="cf-req">*</span></label>

                            <div class="us-wrapper" id="usWrapper">
                                <input type="hidden" id="assignedToInput" name="AssignedToId"
                                       value="@Model.AssignedToId" />

                                <button type="button" class="us-trigger" id="usTrigger">
                                    <span class="us-selected" id="usSelected">
                                        @{
                                            var selUser = Model.AssignableUsers
                                            .FirstOrDefault(u => u.Id == Model.AssignedToId);
                                        }
                                        @if (selUser != null)
                                        {
                                            <span class="us-avatar">
                                                @if (!string.IsNullOrEmpty(selUser.AvatarUrl))
                                                {
                                                    <img src="@selUser.AvatarUrl" alt="" class="us-avatar-img" />
                                                }
                                                else
                                                {
                                                    <span class="us-avatar-init">@selUser.FullName[0]</span>
                                                }
                                            </span>
                                            <span class="us-info">
                                                <span class="us-name">@selUser.FullName</span>
                                                <span class="us-email">@selUser.Email</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="us-placeholder">— Chưa phân công —</span>
                                        }
                                    </span>
                                    <svg class="us-chevron" viewBox="0 0 20 20" fill="none">
                                        <path d="M5 7.5l5 5 5-5" stroke="currentColor"
                                              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </button>

                                <div class="us-dropdown" id="usDropdown">
                                    <div class="us-search-wrap">
                                        <svg viewBox="0 0 20 20" fill="none" class="us-search-icon">
                                            <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5" />
                                            <path d="M13.5 13.5l3 3" stroke="currentColor"
                                                  stroke-width="1.5" stroke-linecap="round" />
                                        </svg>
                                        <input type="text" id="usSearch" class="us-search-input"
                                               placeholder="Tìm theo tên hoặc email..." />
                                    </div>

                                    <ul class="us-list" id="usList">
                                        <li class="us-item @(Model.AssignedToId == null || Model.AssignedToId == 0 ? "is-selected" : "")"
                                            data-value="" data-name="" data-email="">
                                            <span class="us-none-text">— Chưa phân công —</span>
                                        </li>
                                        @foreach (var u in Model.AssignableUsers)
                                        {
                                            <li class="us-item @(Model.AssignedToId == u.Id ? "is-selected" : "")"
                                                data-value="@u.Id"
                                                data-name="@u.FullName.ToLower()"
                                                data-email="@u.Email.ToLower()">
                                                <span class="us-avatar">
                                                    @if (!string.IsNullOrEmpty(u.AvatarUrl))
                                                    {
                                                        <img src="@u.AvatarUrl" alt="" class="us-avatar-img" />
                                                    }
                                                    else
                                                    {
                                                        <span class="us-avatar-init">@u.FullName[0]</span>
                                                    }
                                                </span>
                                                <span class="us-info">
                                                    <span class="us-name">@u.FullName</span>
                                                    <span class="us-email">@u.Email</span>
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>

                            <span class="cf-field-err" id="assignedToErr"></span>
                        </div>
                    </div>
                </div>

                <div class="cf-card-section">
                    <div class="cf-section-label">Thời gian</div>
                    <div class="cf-row">
                        <div class="cf-field">
                            <label class="cf-label">Ngày bắt đầu</label>
                            <div class="date-input-wrap">
                                <svg class="date-icon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                    <rect x="3" y="4" width="18" height="18" rx="3" />
                                    <path d="M16 2v4M8 2v4M3 10h18" />
                                </svg>
                                <input type="text" class="cf-input" id="startDate-picker" placeholder="Chọn ngày & giờ" />
                                <input asp-for="StartDate" type="hidden" id="startDate-hidden" />
                            </div>
                            <span asp-validation-for="Deadline" style="color:#991b1b;font-size:12px;margin-top:4px;display:block;"></span>
                        </div>
                        <div class="cf-field">
                            <label class="cf-label">Deadline</label>
                            <div class="date-input-wrap">
                                <svg class="date-icon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                    <rect x="3" y="4" width="18" height="18" rx="3" />
                                    <path d="M16 2v4M8 2v4M3 10h18" />
                                </svg>
                                <input type="text" class="cf-input" id="deadline-picker" placeholder="Chọn ngày & giờ" />
                                <input asp-for="Deadline" type="hidden" id="deadline-hidden" />
                            </div>
                            <span asp-validation-for="Deadline" style="color:#991b1b;font-size:12px;margin-top:4px;display:block;"></span>
                        </div>
                    </div>
                </div>
            </form>
            <div class="cf-card-section">
                <div class="cf-section-label">Trạng thái</div>
                <div>@Html.Partial("_StatusBadge", Model.Status)</div>
            </div>
            <div class="cf-card-section">
                <div class="cf-section-label">File đính kèm</div>
                <div id="files-table-wrap">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="border-bottom:0.5px solid #e5e7eb;">
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Tên file</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Người upload</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Ngày upload</th>
                                <th style="padding:8px 12px;"></th>
                            </tr>
                        </thead>
                        <tbody id="files-table-body">
                            <tr>
                                <td colspan="4" style="padding:20px;text-align:center;color:#9ca3af;font-size:13px;">
                                    Đang tải...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="cf-card-section">
                <div class="cf-section-label">Thông tin cơ bản</div>
                <div class="cf-field">
                    <label class="cf-label">Tiêu đề</label>
                    <input type="text" class="cf-input" value="@Model.Title" readonly />
                </div>
                <div class="cf-field">
                    <label class="cf-label">Mô tả chi tiết</label>
                    <textarea class="cf-textarea" readonly>@Model.Description</textarea>
                </div>
            </div>

            <div class="cf-card-section">
                <div class="cf-section-label">Phân loại & Phân công</div>
                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Độ ưu tiên</label>
                        <div class="cf-priority-group">
                            <label class="cf-priority-pill cf-priority-pill--low cf-priority-pill--disabled">
                                @if (Model.Priority == 0)
                                {
                                    <input type="radio" checked disabled />
                                }
                                else
                                {
                                    <input type="radio" disabled />
                                }
                                🟢 Thấp
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--medium cf-priority-pill--disabled">
                                @if (Model.Priority == 1)
                                {
                                    <input type="radio" checked disabled />
                                }
                                else
                                {
                                    <input type="radio" disabled />
                                }
                                🟡 TB
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--high cf-priority-pill--disabled">
                                @if (Model.Priority == 2)
                                {
                                    <input type="radio" checked disabled />
                                }
                                else
                                {
                                    <input type="radio" disabled />
                                }
                                🔴 Cao
                            </label>
                        </div>
                    </div>
                    <div class="cf-field">
                        <label class="cf-label">Người thực hiện</label>
                        <input type="text" class="cf-input" value="@Model.AssignedToName" readonly />
                    </div>
                </div>
            </div>

            <div class="cf-card-section">
                <div class="cf-section-label">Thời gian</div>
                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Ngày bắt đầu</label>
                        <input type="text" class="cf-input"
                               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd/MM/yyyy HH:mm") : "—")"
                               readonly />
                    </div>
                    <div class="cf-field">
                        <label class="cf-label">Deadline</label>
                        <input type="text" class="cf-input"
                               value="@(Model.Deadline.HasValue ? Model.Deadline.Value.ToString("dd/MM/yyyy HH:mm") : "—")"
                               readonly />
                    </div>
                </div>
            </div>

            <div class="cf-card-section">
                <div class="cf-section-label">Trạng thái</div>
                @if (!canEdit && (Model.Status == 1 || Model.Status == 2))
                {
                    <select id="status-select" class="cf-select" style="width:100%;">
                        @if (Model.Status == 1)
                        {
                            <option value="1" selected>Chờ xử lý</option>
                            <option value="2">Đang làm</option>
                        }
                        else
                        {
                            <option value="1">Chờ xử lý</option>
                            <option value="2" selected>Đang làm</option>
                        }
                    </select>

                    <form id="user-status-form" method="post" action="@Url.Action("UpdateStatus", new { id = Model.Id })">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="newStatus" id="user-status-input" value="@Model.Status" />
                    </form>
                }
                else
                {
                    <div>@Html.Partial("_StatusBadge", Model.Status)</div>
                }
            </div>
            <div class="cf-card-section">
                <div class="cf-section-label">File đính kèm</div>
                <div id="files-table-wrap">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="border-bottom:0.5px solid #e5e7eb;">
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Tên file</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Người upload</th>
                                <th style="padding:8px 12px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Ngày upload</th>
                                <th style="padding:8px 12px;"></th>
                            </tr>
                        </thead>
                        <tbody id="files-table-body">
                            <tr>
                                <td colspan="4" style="padding:20px;text-align:center;color:#9ca3af;font-size:13px;">
                                    Đang tải...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
<!-- Modal gửi đánh giá -->
<div class="um-overlay" id="submitModal">
    <div class="um-modal um-modal-sm">
        <div class="um-modal-header">
            <h2 class="um-modal-title">Xác nhận gửi đánh giá</h2>
            <button class="um-modal-close" onclick="closeSubmitModal()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="um-modal-body um-delete-body">
            <div class="um-delete-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="9 12 11 14 15 10" />
                </svg>
            </div>
            <p class="um-delete-text">
                Gửi công việc để Manager đánh giá?<br>
                <span style="color:#9ca3af;font-size:13px">Sau khi gửi bạn sẽ không thể chỉnh sửa thêm.</span>
            </p>
        </div>
        <div class="um-modal-footer">
            <button class="um-btn-ghost" onclick="closeSubmitModal()">Hủy</button>
            <button class="um-btn-green" onclick="doSubmitTask()">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
                Gửi đánh giá
            </button>
        </div>
    </div>
</div>
<!-- Modal đánh giá -->
<div class="um-overlay" id="reviewModal">
    <div class="um-modal um-modal-sm" style="max-width:480px;">
        <div class="um-modal-header">
            <input type="hidden" id="rv-task-id" value="@Model.Id" />
            <h2 class="um-modal-title">Đánh giá công việc</h2>
            <button class="um-modal-close" onclick="closeReviewModal()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="um-modal-body">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
                <div id="rv-approve"
                     onclick="selectReview(true)"
                     style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
                            padding:18px 12px;border-radius:10px;border:1.5px solid #e5e7eb;
                            cursor:pointer;transition:all .15s;font-size:13.5px;font-weight:600;color:#374151;text-align:center;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    Duyệt — Hoàn thành
                </div>
                <div id="rv-reject"
                     onclick="selectReview(false)"
                     style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;
                            padding:18px 12px;border-radius:10px;border:1.5px solid #e5e7eb;
                            cursor:pointer;transition:all .15s;font-size:13.5px;font-weight:600;color:#374151;text-align:center;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10" />
                        <line x1="15" y1="9" x2="9" y2="15" />
                        <line x1="9" y1="9" x2="15" y2="15" />
                    </svg>
                    Từ chối
                </div>
            </div>

            <div id="rv-reason-wrap" style="display:none;">
                <label style="font-size:12.5px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">
                    Lý do từ chối <span style="color:#ef4444;">*</span>
                </label>
                <textarea id="rv-reason" class="cf-textarea"
                          placeholder="Mô tả rõ lý do..."></textarea>
                <span id="rv-reason-err" style="font-size:12px;color:#ef4444;margin-top:4px;display:block;"></span>
            </div>
        </div>
        <div class="um-modal-footer">
            <button class="um-btn-ghost" onclick="closeReviewModal()">Hủy</button>
            <button id="rv-submit-btn" class="cf-btn-submit" onclick="doReview()" style="padding:9px 16px;">
                Xác nhận đánh giá
            </button>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/vn.js"></script>
    <script>
        const TASK_ID = @Model.Id;
        const CAN_EDIT = @canEdit.ToString().ToLower();
        const TASK_STATUS = @Model.Status;
        const CURRENT_USER_ID = @ViewBag.CurrentUserId;
        const CURRENT_USER_ROLE = @ViewBag.CurrentUserRole;
        const START_DATE_VALUE = "@(Model.StartDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")";
        const DEADLINE_VALUE = "@(Model.Deadline?.ToString("yyyy-MM-ddTHH:mm") ?? "")";
    </script>
    <script src="~/js/Tasks/Edit.js"></script>
}
@model WorkManagement.Web.Models.Task.TaskFormViewModel
@{
    ViewData["Title"] = "Tạo công việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Page ── */
    .cf-page {
        padding: 28px 32px 64px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .cf-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #6b7280;
        text-decoration: none;
        padding: 6px 10px;
        border-radius: 8px;
        margin-bottom: 20px;
        transition: background .15s, color .15s;
    }

        .cf-back:hover {
            background: #f3f4f6;
            color: #111827;
        }

    /* ── Header row ── */
    .cf-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .cf-heading h1 {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 2px;
        letter-spacing: -0.3px;
    }

    .cf-heading p {
        font-size: 13px;
        color: #6b7280;
        margin: 0;
    }

    .cf-header-btns {
        display: flex;
        gap: 10px;
    }

    .cf-btn-cancel {
        padding: 8px 18px;
        border-radius: 8px;
        border: 0.5px solid #e5e7eb;
        background: #fff;
        font-size: 13.5px;
        font-weight: 500;
        color: #374151;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: background .15s;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
    }

        .cf-btn-cancel:hover {
            background: #f3f4f6;
        }

    .cf-btn-submit {
        padding: 8px 20px;
        border-radius: 8px;
        border: none;
        background: #4f46e5;
        font-size: 13.5px;
        font-weight: 600;
        color: #fff;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: background .15s, transform .1s;
        font-family: 'DM Sans', sans-serif;
    }

        .cf-btn-submit:hover {
            background: #4338ca;
        }

        .cf-btn-submit:active {
            transform: scale(0.98);
        }

    /* ── 2-col layout ── */
    .cf-body {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;
        align-items: start;
    }

    /* ── Card chung ── */
    .cf-card {
        background: #fff;
        border: 0.5px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }

    .cf-card-section {
        padding: 20px 22px;
    }

        .cf-card-section + .cf-card-section {
            border-top: 0.5px solid #f3f4f6;
        }

    .cf-section-label {
        font-size: 11px;
        font-weight: 600;
        color: #9ca3af;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    /* ── Upload card ── */
    .cf-drop-zone {
        border: 1.5px dashed #d1d5db;
        border-radius: 10px;
        padding: 28px 16px;
        text-align: center;
        cursor: pointer;
        transition: border-color .15s, background .15s;
        background: #fafafa;
    }

        .cf-drop-zone:hover, .cf-drop-zone.dragover {
            border-color: #4f46e5;
            background: #f5f3ff;
        }

        .cf-drop-zone svg {
            color: #9ca3af;
            margin-bottom: 10px;
        }

        .cf-drop-zone p {
            font-size: 13px;
            color: #6b7280;
            margin: 0;
            line-height: 1.6;
        }

        .cf-drop-zone span {
            color: #4f46e5;
            font-weight: 600;
            cursor: pointer;
        }

    .cf-drop-input {
        display: none;
    }

    /* File list */
    .cf-file-list {
        margin-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .cf-file-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        background: #f9fafb;
        border: 0.5px solid #e5e7eb;
        border-radius: 8px;
    }

    .cf-file-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: #4f46e5;
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        font-family: 'DM Mono', monospace;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .cf-file-icon--img {
        background: #0891b2;
    }

    .cf-file-icon--pdf {
        background: #dc2626;
    }

    .cf-file-info {
        flex: 1;
        min-width: 0;
    }

    .cf-file-name {
        font-size: 12.5px;
        font-weight: 600;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cf-file-size {
        font-size: 11px;
        color: #9ca3af;
        font-family: 'DM Mono', monospace;
    }

    .cf-file-remove {
        background: none;
        border: none;
        cursor: pointer;
        color: #9ca3af;
        padding: 2px;
        display: flex;
        align-items: center;
        transition: color .15s;
        flex-shrink: 0;
    }

        .cf-file-remove:hover {
            color: #ef4444;
        }

    /* ── Form card ── */
    .cf-field {
        margin-bottom: 15px;
    }

        .cf-field:last-child {
            margin-bottom: 0;
        }

    .cf-label {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .cf-req {
        color: #ef4444;
        margin-left: 2px;
    }

    .cf-input, .cf-select, .cf-textarea {
        width: 100%;
        background: #fafafa;
        border: 0.5px solid #e5e7eb;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 13.5px;
        font-family: 'DM Sans', sans-serif;
        color: #111827;
        outline: none;
        transition: border-color .15s, background .15s;
        box-sizing: border-box;
    }

        .cf-input:focus, .cf-select:focus, .cf-textarea:focus {
            border-color: #4f46e5;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.08);
        }

    .cf-textarea {
        resize: vertical;
        min-height: 96px;
        line-height: 1.6;
    }

    .cf-field-err {
        font-size: 12px;
        color: #ef4444;
        margin-top: 4px;
        display: block;
    }

    .cf-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    /* Priority pills */
    .cf-priority-group {
        display: flex;
        gap: 8px;
    }

    .cf-priority-pill {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 8px 10px;
        border-radius: 8px;
        border: 1.5px solid #e5e7eb;
        background: #fafafa;
        font-size: 12.5px;
        font-weight: 500;
        cursor: pointer;
        transition: all .15s;
        position: relative;
        white-space: nowrap;
    }

        .cf-priority-pill input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }

        .cf-priority-pill:has(input:checked) {
            border-width: 1.5px;
        }

    .cf-priority-pill--low:has(input:checked) {
        background: #eaf3de;
        border-color: #3b6d11;
        color: #3b6d11;
    }

    .cf-priority-pill--medium:has(input:checked) {
        background: #faeeda;
        border-color: #854f0b;
        color: #854f0b;
    }

    .cf-priority-pill--high:has(input:checked) {
        background: #fcebeb;
        border-color: #a32d2d;
        color: #a32d2d;
    }

    /* Alert */
    .cf-alert {
        margin-bottom: 14px;
        padding: 11px 14px;
        background: #fef2f2;
        border: 0.5px solid #fecaca;
        border-radius: 8px;
        font-size: 13px;
        color: #991b1b;
    }
</style>

<div class="cf-header-row">
    <div class="cf-heading">
        <h1>Tạo công việc mới</h1>
        <p>Điền thông tin và phân công cho thành viên</p>
    </div>
    <div class="cf-header-btns">
        <a href="@Url.Action("Index")" class="cf-btn-cancel">Hủy</a>
        <button type="submit" form="cf-form" class="cf-btn-submit">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Tạo công việc
        </button>
    </div>
</div>

<form id="cf-form" asp-action="Create" asp-controller="Tasks"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="cf-alert"></div>

    <div class="cf-body">

        @* ── CỘT TRÁI: Upload ── *@
        <div>
            <div class="cf-card">
                <div class="cf-card-section">
                    <div class="cf-section-label">Tệp đính kèm</div>

                    <div class="cf-drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
                            <polyline points="17 8 12 3 7 8" />
                            <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                        <p>
                            <span>Click để tải lên</span> hoặc kéo thả<br />
                            PNG, JPG, PDF (tối đa 5MB)
                        </p>
                    </div>
                    <input type="file" id="fileInput" name="Attachments" class="cf-drop-input"
                           multiple accept=".png,.jpg,.jpeg,.pdf,.doc,.docx,.xlsx" />

                    <div class="cf-file-list" id="fileList"></div>
                </div>
            </div>
        </div>

        @* ── CỘT PHẢI: Form ── *@
        <div class="cf-card">

            @* Thông tin cơ bản *@
            <div class="cf-card-section">
                <div class="cf-section-label">Thông tin cơ bản</div>

                <div class="cf-field">
                    <label asp-for="Title" class="cf-label">
                        Tiêu đề <span class="cf-req">*</span>
                    </label>
                    <input asp-for="Title" class="cf-input"
                           placeholder="Mô tả ngắn gọn công việc cần làm" />
                    <span asp-validation-for="Title" class="cf-field-err"></span>
                </div>

                <div class="cf-field">
                    <label asp-for="Description" class="cf-label">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="cf-textarea"
                              placeholder="Hướng dẫn, yêu cầu cụ thể, tài nguyên liên quan..."></textarea>
                </div>
            </div>

            @* Phân loại & phân công *@
            <div class="cf-card-section">
                <div class="cf-section-label">Phân loại & Phân công</div>

                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Độ ưu tiên</label>
                        <div class="cf-priority-group">
                            <label class="cf-priority-pill cf-priority-pill--low">
                                @if (Model.Priority == 0)
                                {
                                    <input type="radio" asp-for="Priority" value="0" checked />
                                }
                                else
                                {
                                    <input type="radio" asp-for="Priority" value="0" />
                                }
                                🟢 Thấp
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--medium">
                                @if (Model.Priority == 1)
                                {
                                    <input type="radio" asp-for="Priority" value="1" checked />
                                }
                                else
                                {
                                    <input type="radio" asp-for="Priority" value="1" />
                                }
                                🟡 TB
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--high">
                                @if (Model.Priority == 2)
                                {
                                    <input type="radio" asp-for="Priority" value="2" checked />
                                }
                                else
                                {
                                    <input type="radio" asp-for="Priority" value="2" />
                                }
                                🔴 Cao
                            </label>
                        </div>
                    </div>

                    <div class="cf-field">
                        <label asp-for="AssignedToId" class="cf-label">
                            Giao cho <span class="cf-req">*</span>
                        </label>
                        <select asp-for="AssignedToId" class="cf-select">
                            <option value="">— Chưa phân công —</option>
                            @foreach (var u in Model.AssignableUsers)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        </select>
                        <span asp-validation-for="AssignedToId" class="cf-field-err"></span>
                    </div>
                </div>
            </div>

            @* Thời gian *@
            <div class="cf-card-section">
                <div class="cf-section-label">Thời gian</div>

                <div class="cf-row">
                    <div class="cf-field">
                        <label asp-for="StartDate" class="cf-label">Ngày bắt đầu</label>
                        <input asp-for="StartDate" type="date" class="cf-input" />
                    </div>
                    <div class="cf-field">
                        <label asp-for="Deadline" class="cf-label">Deadline</label>
                        <input asp-for="Deadline" type="date" class="cf-input" />
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileList = document.getElementById('fileList');
        let selectedFiles = [];

        // Drag & drop
        dropZone.addEventListener('dragover', e => {
            e.preventDefault();
            dropZone.classList.add('dragover');
        });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
        dropZone.addEventListener('drop', e => {
            e.preventDefault();
            dropZone.classList.remove('dragover');
            addFiles(e.dataTransfer.files);
        });

        fileInput.addEventListener('change', () => addFiles(fileInput.files));

        function addFiles(files) {
            Array.from(files).forEach(f => {
                if (f.size > 5 * 1024 * 1024) {
                    alert(`File "${f.name}" vượt quá 5MB`);
                    return;
                }
                if (!selectedFiles.find(x => x.name === f.name && x.size === f.size)) {
                    selectedFiles.push(f);
                }
            });
            renderFileList();
            syncFileInput();
        }

        function removeFile(idx) {
            selectedFiles.splice(idx, 1);
            renderFileList();
            syncFileInput();
        }

        function getExt(name) {
            return name.split('.').pop().toUpperCase();
        }

        function getIconClass(name) {
            const ext = name.split('.').pop().toLowerCase();
            if (['png','jpg','jpeg','gif','webp'].includes(ext)) return 'cf-file-icon--img';
            if (ext === 'pdf') return 'cf-file-icon--pdf';
            return '';
        }

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }

        function renderFileList() {
            fileList.innerHTML = '';
            selectedFiles.forEach((f, i) => {
                const item = document.createElement('div');
                item.className = 'cf-file-item';
                item.innerHTML = `
                    <div class="cf-file-icon ${getIconClass(f.name)}">${getExt(f.name)}</div>
                    <div class="cf-file-info">
                        <div class="cf-file-name">${f.name}</div>
                        <div class="cf-file-size">${formatSize(f.size)}</div>
                    </div>
                    <button type="button" class="cf-file-remove" onclick="removeFile(${i})" title="Xóa">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>`;
                fileList.appendChild(item);
            });
        }

        function syncFileInput() {
            const dt = new DataTransfer();
            selectedFiles.forEach(f => dt.items.add(f));
            fileInput.files = dt.files;
        }
    </script>
}
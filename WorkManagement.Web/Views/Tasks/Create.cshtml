@model WorkManagement.Web.Models.Task.TaskFormViewModel
@{
    ViewData["Title"] = "Tạo công việc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/Tasks/Create.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css" />
<div class="cf-header-row">
    <div class="cf-heading">
        <h1>Tạo công việc mới</h1>
        <p>Điền thông tin và phân công cho thành viên</p>
    </div>
    <div class="cf-header-btns">
        <a href="@Url.Action("Index")" class="cf-btn-cancel">Hủy</a>
        <button type="submit" form="cf-form" class="cf-btn-submit">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Tạo công việc
        </button>
    </div>
</div>

<form id="cf-form" asp-action="Create" asp-controller="Tasks"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="cf-alert"></div>

    <div class="cf-body">

        @* ── CỘT TRÁI: Upload ── *@
        <div>
            <div class="cf-card">
                <div class="cf-card-section">
                    <div class="cf-section-label">Tệp đính kèm</div>

                    <div class="cf-drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                        <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" />
                            <polyline points="17 8 12 3 7 8" />
                            <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                        <p>
                            <span>Click để tải lên</span> hoặc kéo thả<br />
                            PNG, JPG, PDF (tối đa 5MB)
                        </p>
                    </div>
                    <input type="file" id="fileInput" name="Attachments" class="cf-drop-input"
                           multiple accept=".png,.jpg,.jpeg,.pdf,.doc,.docx,.xlsx" />

                    <div class="cf-file-list" id="fileList"></div>
                </div>
            </div>
        </div>

        @* ── CỘT PHẢI: Form ── *@
        <div class="cf-card">

            @* Thông tin cơ bản *@
            <div class="cf-card-section">
                <div class="cf-section-label">Thông tin cơ bản</div>

                <div class="cf-field">
                    <label asp-for="Title" class="cf-label">
                        Tiêu đề <span class="cf-req">*</span>
                    </label>
                    <input asp-for="Title" class="cf-input"
                           placeholder="Mô tả ngắn gọn công việc cần làm" />
                    <span asp-validation-for="Title" class="cf-field-err"></span>
                </div>

                <div class="cf-field">
                    <label asp-for="Description" class="cf-label">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="cf-textarea"
                              placeholder="Hướng dẫn, yêu cầu cụ thể, tài nguyên liên quan..."></textarea>
                </div>
            </div>

            @* Phân loại & phân công *@
            <div class="cf-card-section">
                <div class="cf-section-label">Phân loại & Phân công</div>

                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Độ ưu tiên</label>
                        <div class="cf-priority-group">
                            <label class="cf-priority-pill cf-priority-pill--low">
                                @if (Model.Priority == 0)
                                {
                                    <input type="radio" asp-for="Priority" value="0" checked />
                                }
                                else
                                {
                                    <input type="radio" asp-for="Priority" value="0" />
                                }
                                🟢 Thấp
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--medium">
                                @if (Model.Priority == 1)
                                {
                                    <input type="radio" asp-for="Priority" value="1" checked />
                                }
                                else
                                {
                                    <input type="radio" asp-for="Priority" value="1" />
                                }
                                🟡 TB
                            </label>
                            <label class="cf-priority-pill cf-priority-pill--high">
                                @if (Model.Priority == 2)
                                {
                                    <input type="radio" asp-for="Priority" value="2" checked />
                                }
                                else
                                {
                                    <input type="radio" asp-for="Priority" value="2" />
                                }
                                🔴 Cao
                            </label>
                        </div>
                    </div>

                    <div class="cf-field">
                        <label asp-for="AssignedToId" class="cf-label">
                            Giao cho <span class="cf-req">*</span>
                        </label>
                        <select asp-for="AssignedToId" class="cf-select">
                            <option value="">— Chưa phân công —</option>
                            @foreach (var u in Model.AssignableUsers)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        </select>
                        <span asp-validation-for="AssignedToId" class="cf-field-err"></span>
                    </div>
                </div>
            </div>

            @* Thời gian *@
            <div class="cf-card-section">
                <div class="cf-section-label">Thời gian</div>
                <div class="cf-row">
                    <div class="cf-field">
                        <label class="cf-label">Ngày bắt đầu</label>
                        <div class="date-input-wrap">
                            <svg class="date-icon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="18" rx="3" />
                                <path d="M16 2v4M8 2v4M3 10h18" />
                            </svg>
                            <input type="text" class="cf-input" id="startDate-picker" placeholder="Chọn ngày & giờ" />
                            <input asp-for="StartDate" type="hidden" id="startDate-hidden" />
                        </div>
                        <span asp-validation-for="Deadline" style="color:#991b1b;font-size:12px;margin-top:4px;display:block;"></span>
                    </div>
                    <div class="cf-field">
                        <label class="cf-label">Deadline</label>
                        <div class="date-input-wrap">
                            <svg class="date-icon" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="18" rx="3" />
                                <path d="M16 2v4M8 2v4M3 10h18" />
                            </svg>
                            <input type="text" class="cf-input" id="deadline-picker" placeholder="Chọn ngày & giờ" />
                            <input asp-for="Deadline" type="hidden" id="deadline-hidden" />
                        </div>
                        <span asp-validation-for="Deadline" style="color:#991b1b;font-size:12px;margin-top:4px;display:block;"></span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/vn.js"></script>
    <script src="~/js/Tasks/Create.js"></script>
}
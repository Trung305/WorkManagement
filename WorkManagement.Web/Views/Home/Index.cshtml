@model WorkManagement.Core.DTOs.Dashboard.DashboardStatsDto
@{
    ViewData["Title"] = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var now = DateTime.Now;
    var greeting = now.Hour < 12 ? "buổi sáng" : now.Hour < 18 ? "buổi chiều" : "buổi tối";
    var userName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "bạn";

    var priorityLabel = new[] { "", "🟢 Thấp", "🟡 Trung bình", "🔴 Cao" };
    var statusLabel = new[] { "", "Chờ xử lý", "Đang làm", "Chờ duyệt", "Hoàn thành", "Từ chối" };

    // Calendar
    var firstDay = new DateTime(Model.CurrentYear, Model.CurrentMonth, 1);
    var daysInMonth = DateTime.DaysInMonth(Model.CurrentYear, Model.CurrentMonth);
    var startDow = (int)firstDay.DayOfWeek; // 0=CN
    var monthName = firstDay.ToString("MMMM, yyyy", new System.Globalization.CultureInfo("vi-VN"));
    var FullName = Context.Items["FullName"]?.ToString();
}

<div class="greeting">
    <h1>Chào @greeting, @FullName</h1>
    <p>
        @if (Model.TodayTasks > 0)
        {
            <span>Hôm nay bạn có <strong>@Model.TodayTasks</strong> công việc cần hoàn thành</span>
        }
        else
        {
            <span>Không có công việc nào đến hạn hôm nay</span>
        }
    </p>
</div>
<div class="stats-grid">
    <div class="stat-card">
        <h3>Công việc hôm nay</h3>
        <div class="value">@Model.TodayTasks</div>
        <div>
            <span class="stat-badge badge-blue">@Model.TotalTasks tổng cộng</span>
        </div>
    </div>
    <div class="stat-card">
        <h3>Quá hạn</h3>
        <div class="value @(Model.OverdueTasks > 0 ? "text-red" : "")">@Model.OverdueTasks</div>
        <div>
            @if (Model.OverdueTasks > 0)
            {
                <span class="stat-badge badge-red">Cần xử lý</span>
            }
            else
            {
                <span class="stat-badge badge-green">Tốt</span>
            }
        </div>
    </div>
    <div class="stat-card">
        <h3>Hoàn thành tuần này</h3>
        <div class="value">@Model.CompletedThisWeek</div>
        <div>
            @{
                var diff = Model.CompletedThisWeek - Model.CompletedLastWeek;
            }
            @if (diff >= 0)
            {
                <span class="stat-badge badge-green">+@diff so với tuần trước</span>
            }
            else
            {
                <span class="stat-badge badge-red">@diff so với tuần trước</span>
            }
        </div>
    </div>
    <div class="stat-card">
        <h3>Tỉ lệ hoàn thành</h3>
        <div class="value">@Model.CompletionRate%</div>
        <div class="progress-bar">
            <div class="progress-fill" style="width:@Model.CompletionRate%"></div>
        </div>
    </div>
</div>

<div class="content-grid">
    <div class="tasks-column">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Công việc sắp tới</span>
                <a href="@Url.Action("Index", "Tasks")" class="card-link">Xem tất cả</a>
            </div>
            @if (Model.UpcomingTasks.Any())
            {
                foreach (var t in Model.UpcomingTasks)
                {
                    var isDone = t.Status == 4;
                    <div class="task-item">
                        <div class="task-info">
                            <div class="task-name @(isDone ? "done" : "")"
                                 style="cursor:pointer"
                                 onclick="location.href='@Url.Action("Edit", "Tasks", new { id = t.Id })'">
                                @t.Title
                            </div>
                            <div class="task-meta">
                                @if (t.Deadline.HasValue)
                                {
                                    <span>Deadline: @t.Deadline.Value.ToString("dd/MM HH:mm")</span>
                                }
                                @if (!string.IsNullOrEmpty(t.AssignedToName))
                                {
                                    <span> · @t.AssignedToName</span>
                                }
                            </div>
                        </div>
                        @{
                            var (tagCls, tagLabel) = t.Priority switch
                            {
                                1 => ("tag-low", "Thấp"),
                                2 => ("tag-mid", "Trung bình"),
                                3 => ("tag-high", "Cao"),
                                _ => ("tag-low", "—")
                            };
                        }
                        <span class="task-tag @tagCls">@tagLabel</span>
                    </div>
                }
            }
            else
            {
                <div style="padding:24px 0;text-align:center;color:#9ca3af;font-size:13px;">
                    Không có công việc nào
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-title">Sắp đến hạn</span>
                <a href="@Url.Action("Index", "Tasks")" class="card-link">Xem tất cả</a>
            </div>
            @if (Model.NearDeadlineTasks.Any())
            {
                foreach (var t in Model.NearDeadlineTasks)
                {
                    <div class="task-item">
                        <div class="task-info">
                            <div class="task-name"
                                 style="cursor:pointer"
                                 onclick="location.href='@Url.Action("Edit", "Tasks", new { id = t.Id })'">
                                @t.Title
                            </div>
                            <div class="task-meta">
                                @if (t.Deadline.HasValue)
                                {
                                    var daysLeft = (t.Deadline.Value.Date - DateTime.Today).Days;
                                    @if (daysLeft == 0)
                                    {
                                        <span style="color:#dc2626;">Hôm nay</span>
                                    }
                                    else if (daysLeft == 1)
                                    {
                                        <span style="color:#ea580c;">Ngày mai</span>
                                    }
                                    else
                                    {
                                        <span>Còn @daysLeft ngày</span>
                                    }
                                }
                            </div>
                        </div>
                        @{
                            var (tagCls2, tagLabel2) = t.Priority switch
                            {
                                1 => ("tag-low", "Thấp"),
                                2 => ("tag-mid", "Trung bình"),
                                3 => ("tag-high", "Cao"),
                                _ => ("tag-low", "—")
                            };
                        }
                        <span class="task-tag @tagCls2">@tagLabel2</span>
                    </div>
                }
            }
            else
            {
                <div style="padding:24px 0;text-align:center;color:#9ca3af;font-size:13px;">
                    Không có công việc nào sắp đến hạn
                </div>
            }
        </div>
    </div>

    <div class="right-column">
        @if (Model.OverdueTasks > 0)
        {
            <div class="alert-box">
                <div class="alert-title">
                    <div class="alert-dot"></div>
                    Cảnh báo
                </div>
                <div class="alert-text">
                    Bạn có <strong>@Model.OverdueTasks</strong> công việc đã quá hạn. Hãy xử lý sớm!
                </div>
            </div>
        }

        <div class="calendar-box">
            <div class="calendar-header">
                <span class="card-title">@monthName</span>
            </div>
            <div class="calendar-grid">
                @foreach (var d in new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" })
                {
                    <div class="calendar-day-name">@d</div>
                }

                @* Ô trống đầu tháng *@
                @for (int i = 0; i < startDow; i++)
                {
                    <div></div>
                }

                @* Các ngày *@
                @for (int d = 1; d <= daysInMonth; d++)
                {
                    var isToday = d == Model.Today;
                    var hasTask = Model.DeadlineDays.Contains(d);
                    var cls = "calendar-date";
                    @if (isToday) { cls += " active"; }
                    @if (hasTask && !isToday) { cls += " has-task"; }

                    var dateStr = $"{Model.CurrentYear}-{Model.CurrentMonth:D2}-{d:D2}";
                    <div class="@cls"
                         style="cursor:pointer"
                         onclick="filterByDate('@dateStr')"
                         title="@(hasTask ? "Có task deadline ngày này" : "")">
                        @d
                    </div>
                }
            </div>
            <div class="calendar-footer">
                <span>Hôm nay</span>
                <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>
        function filterByDate(dateStr) {
            window.location.href = `/Tasks/Index?status=&deadline=${dateStr}`;
        }
</script>
}
@{
    ViewData["Title"] = "NewTank";
}
@{
    Layout = null;
}


<link rel="stylesheet" href="/css/Newtank.css">


<div class="sidebar">
<div class="logo"><span style="background: white; color: #5a5c69; padding: 2px 8px; border-radius: 4px;">C</span> CodingLab</div>
<ul class="menu">
    <li><a href="/Home/Index" class="menu-link" style="color:#555; background:transparent;">🏠 Trang chủ</a></li>
    <li><a href="#" class="menu-link active">📄 Thêm Công Việc</a></li>
</ul>
<div class="logout">🚪 Đăng xuất</div>
</div>

<div class="main-content">
    <div class="topbar">
        <input type="text" class="search-bar" placeholder="🔍 Search...">
        <div class="profile-img"><img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Profile"></div>
    </div>

    <div class="form-container">

        <form method="post" action="/Home/NewTask">
            <div class="header-actions">
                <h2>Create New Task</h2>
                <div class="btn-group">
                    <a href="/Home/Index" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-create">Create</button>
                </div>
            </div>

            <div class="form-body">
                <div class="upload-section">
                    <h4>Upload from your device</h4>
                    <div class="drop-zone">
                        <span style="font-size: 24px; color: #999;">📄</span><br><br>
                        <span style="color:#2ecc71; cursor:pointer; font-weight:bold;">Click to Upload</span> or drag and drop PNG,<br> JPG or pdf (max, 2mb)
                    </div>

                    <div class="uploading-box">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <div class="pdf-icon">PDF</div>
                            <div>
                                <div style="font-weight: bold; font-size: 13px;">Design1.pdf</div>
                                <div style="font-size: 11px; color: #555;">200 KB - 70%</div>
                            </div>
                        </div>
                        <div style="width: 25px; height: 25px; border-radius: 50%; border: 4px solid #fff; border-top: 4px solid #555; transform: rotate(45deg);"></div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-group">
                        <label>Tiêu đề</label>
                        <input type="text" name="Title" class="form-input" placeholder="Nhập tiêu đề...">
                    </div>

                    <div class="form-group">
                        <label class="label-red">Loại</label>
                        <input type="text" name="Type" class="form-input" placeholder="Develop a new home">
                    </div>

                    <div style="display: flex; gap: 30px; margin-bottom: 20px;">
                        <div>
                            <label class="label-red" style="font-size: 13px; font-weight:bold; margin-bottom: 5px; display:block;">Độ ưu tiên</label>
                            <div style="background: #f0f3f8; padding: 5px 15px; border-radius: 6px; display:inline-block; font-weight:bold; cursor:pointer;">↓ Thấp</div>
                            <span style="margin-left: 15px; color:#555; cursor:pointer;">↑ Cao</span>
                        </div>
                    </div>

                    <p style="font-size: 11px; color: #555; margin-bottom: 10px;">Date format: YYYY-MM-DD</p>

                    <div class="date-time-row">
                        <div class="form-group">
                            <label class="label-red">Ngày bắt đầu</label>
                            <input type="date" name="StartDate" class="form-input" style="padding: 10px;">
                        </div>
                        <div class="form-group">
                            <label class="label-red">Thời gian</label>
                            <input type="time" name="StartTime" class="form-input" style="padding: 10px;">
                        </div>
                    </div>

                    <div class="date-time-row">
                        <div class="form-group">
                            <label class="label-red">Ngày kết thúc</label>
                            <input type="date" name="EndDate" class="form-input" style="padding: 10px;">
                        </div>
                        <div class="form-group">
                            <label class="label-red">Thời gian</label>
                            <input type="time" name="EndTime" class="form-input" style="padding: 10px;">
                        </div>
                    </div>

                    <div class="form-group" style="margin-top: 10px;">
                        <label class="label-red">Thêm người làm việc</label>
                        <div class="assignee-box">
                            <div style="display:flex; align-items:center; gap:10px;">
                                <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Avatar">
                                <span>Nguyễn Văn A</span>
                            </div>
                            <span style="cursor:pointer;">▼</span>
                        </div>
                    </div>
                </div>
            </div>
        </form>

    </div>
</div>
@{
    ViewData["Title"] = "Login";
    
}
@{
    Layout = null;
}
@model WorkManagement.Core.DTOs.Auth.LoginDto
<style>
    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f4f6f9; /* Màu nền ngoài cùng của trang */
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    /* CONTAINER CHÍNH */
    .login-container {
        display: flex;
        width: 900px;
        height: 550px;
        background: #9ba9cd; /* Nền xanh bên phải */
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    /* BÊN TRÁI (Ảnh minh họa) */
    .left {
        flex: 1;
        background-color: white;
        border: 4px solid #338df2; /* Viền xanh quanh khung trắng */
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        /* Đẩy khung trái lệch ra một chút để tạo hiệu ứng như trong ảnh */
        margin: -2px 0 -2px -2px;
    }

        .left img {
            width: 100%;
            max-width: 380px;
            object-fit: contain;
        }

    /* BÊN PHẢI (Form đăng nhập) */
    .right {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: transparent; /* Lấy màu nền của login-container */
    }

    /* KHUNG FORM */
    .form-box {
        width: 320px;
        display: flex;
        flex-direction: column;
    }

        .form-box h2 {
            text-align: center;
            margin-bottom: 30px;
            color: black;
            font-size: 24px;
        }

    /* Ô NHẬP LIỆU */
    .input-box {
        padding: 14px 20px;
        margin-bottom: 15px;
        border: none;
        border-radius: 30px; /* Bo tròn hoàn toàn */
        font-size: 14px;
        background: #ffffff;
        color: #333;
        outline: none;
    }

        .input-box::placeholder {
            color: #555;
        }

    /* NÚT ĐĂNG NHẬP */
    .login-btn {
        padding: 14px;
        border: none;
        background: black;
        color: white;
        border-radius: 30px; /* Bo tròn hoàn toàn */
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        margin-bottom: 20px;
        margin-top: 5px;
        transition: background 0.3s ease;
    }

        .login-btn:hover {
            background: #333;
        }

    /* CHỮ ĐĂNG KÝ */
    .register {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
        font-size: 14px;
    }

        .register a {
            color: #c9e2fb; /* Màu xanh lơ nhạt */
            text-decoration: none;
            font-weight: bold;
            margin-left: 5px;
        }

            .register a:hover {
                text-decoration: underline;
            }

    /* NÚT ĐĂNG NHẬP GOOGLE */
    .google-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border: 1px solid #ccc;
        background: white;
        color: #4a5568;
        font-weight: bold;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        transition: background 0.3s ease;
    }

        .google-btn:hover {
            background: #f8f9fa;
        }
</style>

<div class="login-container">

    <div class="left">
        <img src="/images/anhnen.png" alt="Illustration">
    </div>

    <div class="right">
        <form class="form-box" asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <h2>Đăng nhập</h2>

            @if (ViewBag.Error != null)
            {
                <div style="color:red; text-align:center; margin-bottom:10px; font-size:13px;">
                    @ViewBag.Error
                </div>
            }

            <input class="input-box" asp-for="Email" placeholder="Email" />
            <span asp-validation-for="Email" style="color:red; font-size:12px; margin-bottom:8px;"></span>

            <input class="input-box" asp-for="Password" type="password" placeholder="Mật khẩu" />
            <span asp-validation-for="Password" style="color:red; font-size:12px; margin-bottom:8px;"></span>

            <button type="submit" class="login-btn">Đăng nhập</button>

            <div class="register">
                Không có tài khoản? <a href="/Account/Register">Đăng ký</a>
            </div>

            <button type="button" class="google-btn">
                <img src="https://cdn-icons-png.flaticon.com/512/281/281764.png" width="18" alt="Google Logo">
                Đăng nhập với Google
            </button>
        </form>
    </div>

</div>
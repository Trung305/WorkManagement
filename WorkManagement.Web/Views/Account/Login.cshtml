@{
    ViewData["Title"] = "Login";
}

<style>

    .login-container {
        width: 900px;
        height: 500px;
        margin: 50px auto;
        display: flex;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }

    .left {
        width: 50%;
        background: white;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .left img {
            width: 80%;
        }

    .right {
        width: 50%;
        background: #7f93b8;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .form-box {
        width: 70%;
    }

    .input-box {
        width: 100%;
        padding: 12px;
        margin: 10px 0;
        border-radius: 25px;
        border: none;
    }

    .login-btn {
        width: 100%;
        padding: 12px;
        border-radius: 25px;
        border: none;
        background: black;
        color: white;
    }

    .register {
        text-align: center;
        margin-top: 15px;
    }

    .google-btn {
        margin-top: 10px;
        width: 100%;
        padding: 8px;
    }
</style>


<div class="login-container">

    <div class="left">
        <img src="#">
    </div>

    <div class="right">

        <form class="form-box" method="post" action="/Account/Login">

            <h2>Đăng nhập</h2>

            <input class="input-box" type="email" name="email" placeholder="Email">

            <input class="input-box" type="password" name="password" placeholder="Mật khẩu">

            <button class="login-btn">Đăng nhập</button>

            <div class="register">
                Không có tài khoản?
                <a href="/Account/Register">Đăng ký</a>
            </div>

            <button class="google-btn">
                <img src="https://cdn-icons-png.flaticon.com/512/281/281764.png" width="18">
                Đăng nhập với Google
            </button>

        </form>

    </div>

</div>
@model WorkManagement.Core.DTOs.Dashboard.StatsDto
@{
    ViewData["Title"] = "Thống kê";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool canSeeMember = User.FindFirst("role")?.Value is "1" or "2";
}

<style>

    .st-header {
        margin-bottom: 28px;
    }

        .st-header h1 {
            font-size: 24px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 4px;
        }

        .st-header p {
            font-size: 14px;
            color: #6b7280;
            margin: 0;
        }

    /* ── Stat cards ── */
    .st-cards {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    .st-card {
        background: #fff;
        border: 0.5px solid #e5e7eb;
        border-radius: 14px;
        padding: 20px 22px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .st-card-label {
        font-size: 13px;
        color: #6b7280;
        font-weight: 500;
    }

    .st-card-val {
        font-size: 36px;
        font-weight: 700;
        font-family: 'DM Mono', monospace;
        color: #111827;
        line-height: 1;
    }

    .st-card-sub {
        font-size: 12.5px;
        color: #9ca3af;
        margin-top: 2px;
    }

    .st-card--pending .st-card-val {
        color: #92400e;
    }

    .st-card--progress .st-card-val {
        color: #1d4ed8;
    }

    .st-card--review .st-card-val {
        color: #5b21b6;
    }

    .st-card--done .st-card-val {
        color: #166534;
    }

    .st-card--rejected .st-card-val {
        color: #991b1b;
    }

    /* ── Charts grid ── */
    .st-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    .st-chart-card {
        background: #fff;
        border: 0.5px solid #e5e7eb;
        border-radius: 14px;
        padding: 22px 24px;
    }

    .st-chart-title {
        font-size: 15px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 20px;
    }

    .st-chart-wrap {
        position: relative;
        height: 240px;
    }

    /* ── Member table ── */
    .st-member-card {
        background: #fff;
        border: 0.5px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 24px;
    }

    .st-member-header {
        padding: 20px 24px 16px;
        border-bottom: 0.5px solid #f3f4f6;
    }

        .st-member-header h2 {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
            margin: 0;
        }

    .st-table {
        width: 100%;
        border-collapse: collapse;
    }

        .st-table th {
            padding: 11px 18px;
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .05em;
            background: #f9fafb;
            border-bottom: 0.5px solid #e5e7eb;
            text-align: left;
        }

        .st-table td {
            padding: 14px 18px;
            font-size: 14px;
            color: #374151;
            border-bottom: 0.5px solid #f3f4f6;
            vertical-align: middle;
        }

        .st-table tbody tr:last-child td {
            border-bottom: none;
        }

        .st-table tbody tr:hover {
            background: #fafafa;
        }

    .st-member-name {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .st-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #ede9fe;
        color: #4f46e5;
        font-size: 13px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .st-progress {
        height: 7px;
        background: #f3f4f6;
        border-radius: 4px;
        overflow: hidden;
        width: 120px;
    }

    .st-progress-fill {
        height: 100%;
        border-radius: 4px;
        background: #4f46e5;
        transition: width .3s;
    }

    .st-rate {
        font-size: 14px;
        font-weight: 700;
        font-family: 'DM Mono', monospace;
        color: #111827;
    }

    .st-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12.5px;
        font-weight: 600;
    }

    .st-badge--done {
        background: #dcfce7;
        color: #166534;
    }

    .st-badge--progress {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .st-badge--overdue {
        background: #fee2e2;
        color: #991b1b;
    }
</style>

<div class="st-page">
    <div class="st-header">
        <h1>Thống kê</h1>
        <p>Tổng quan hiệu suất và tiến độ công việc</p>
    </div>
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:24px;flex-wrap:wrap;">
        @{
            var ranges = new[] {
        ("7d",        "7 ngày"),
        ("30d",       "30 ngày"),
        ("90d",       "90 ngày"),
        ("thisMonth", "Tháng này"),
        ("lastMonth", "Tháng trước"),
        ("all",       "Tất cả"),
        };
            var currentRange = ViewBag.Range as string ?? "30d";
        }

        @foreach (var (val, label) in ranges)
        {
            var isActive = currentRange == val;
            <a href="@Url.Action("Index", new { range = val })"
               style="padding:7px 14px;border-radius:8px;font-size:13.5px;font-weight:@(isActive?"600":"500");
                  text-decoration:none;border:0.5px solid @(isActive?"#4f46e5":"#e5e7eb");
                  background:@(isActive?"#4f46e5":"#fff");
                  color:@(isActive?"#fff":"#374151");
                  transition:all .15s;">
                @label
            </a>
        }

        <form method="get" action="@Url.Action("Index")" style="display:flex;align-items:center;gap:6px;margin-left:8px;">
            <input type="date" name="from" value="@ViewBag.From"
                   style="padding:7px 10px;border:0.5px solid #e5e7eb;border-radius:8px;font-size:13px;
                      font-family:'DM Sans',sans-serif;color:#374151;outline:none;" />
            <span style="color:#9ca3af;font-size:13px;">→</span>
            <input type="date" name="to" value="@ViewBag.To"
                   style="padding:7px 10px;border:0.5px solid #e5e7eb;border-radius:8px;font-size:13px;
                      font-family:'DM Sans',sans-serif;color:#374151;outline:none;" />
            <button type="submit"
                    style="padding:7px 14px;border-radius:8px;border:none;background:#4f46e5;
                       color:#fff;font-size:13px;font-weight:600;cursor:pointer;
                       font-family:'DM Sans',sans-serif;">
                Lọc
            </button>
        </form>
    </div>
    <div class="st-cards">
        <div class="st-card">
            <div class="st-card-label">Tổng công việc</div>
            <div class="st-card-val">@Model.TotalTasks</div>
            <div class="st-card-sub">Tất cả trạng thái</div>
        </div>
        <div class="st-card st-card--pending">
            <div class="st-card-label">Chờ xử lý</div>
            <div class="st-card-val">@Model.Pending</div>
            <div class="st-card-sub">Chưa bắt đầu</div>
        </div>
        <div class="st-card st-card--progress">
            <div class="st-card-label">Đang làm</div>
            <div class="st-card-val">@Model.InProgress</div>
            <div class="st-card-sub">Đang thực hiện</div>
        </div>
        <div class="st-card st-card--done">
            <div class="st-card-label">Hoàn thành</div>
            <div class="st-card-val">@Model.Completed</div>
            <div class="st-card-sub">Đã xong</div>
        </div>
        <div class="st-card st-card--rejected">
            <div class="st-card-label">Từ chối</div>
            <div class="st-card-val">@Model.Rejected</div>
            <div class="st-card-sub">Không đạt</div>
        </div>
    </div>

    <div class="st-grid">
        <div class="st-chart-card">
            <div class="st-chart-title">Phân bổ trạng thái</div>
            <div class="st-chart-wrap">
                <canvas id="chartStatus"></canvas>
            </div>
        </div>

        <div class="st-chart-card">
            <div class="st-chart-title">Đúng hạn vs Quá hạn</div>
            <div class="st-chart-wrap">
                <canvas id="chartOntime"></canvas>
            </div>
        </div>

        <div class="st-chart-card" style="grid-column: span 2;">
            <div class="st-chart-title">Công việc hoàn thành — 7 ngày gần nhất</div>
            <div class="st-chart-wrap" style="height:200px;">
                <canvas id="chartWeekly"></canvas>
            </div>
        </div>
    </div>

    @if (canSeeMember && Model.MemberStats.Any())
    {
        <div class="st-member-card">
            <div class="st-member-header">
                <h2>Hiệu suất thành viên</h2>
            </div>
            <table class="st-table">
                <thead>
                    <tr>
                        <th>Thành viên</th>
                        <th>Tổng</th>
                        <th>Hoàn thành</th>
                        <th>Đang làm</th>
                        <th>Quá hạn</th>
                        <th>Tỉ lệ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.MemberStats)
                    {
                        <tr>
                            <td>
                                <div class="st-member-name">
                                    <div class="st-avatar">@m.FullName[0].ToString().ToUpper()</div>
                                    <span style="font-weight:600;font-size:14px;">@m.FullName</span>
                                </div>
                            </td>
                            <td style="font-family:'DM Mono',monospace;font-weight:600;font-size:15px;">@m.Total</td>
                            <td><span class="st-badge st-badge--done">@m.Completed</span></td>
                            <td><span class="st-badge st-badge--progress">@m.InProgress</span></td>
                            <td>
                                @if (m.Overdue > 0)
                                {
                                    <span class="st-badge st-badge--overdue">@m.Overdue</span>
                                }
                                else
                                {
                                    <span style="color:#9ca3af;font-size:13px;">—</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <div class="st-progress">
                                        <div class="st-progress-fill" style="width:@m.CompletionRate%"></div>
                                    </div>
                                    <span class="st-rate">@m.CompletionRate%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/chart.umd.min.js"></script>
    <script>
        const COLORS = {
            pending:  '#fef3c7',
            progress: '#dbeafe',
            review:   '#ede9fe',
            done:     '#dcfce7',
            rejected: '#fee2e2',
            border: {
                pending:  '#92400e',
                progress: '#1d4ed8',
                review:   '#5b21b6',
                done:     '#166534',
                rejected: '#991b1b',
            }
        };

        // Chart 1 — Biểu đồ tròn trạng thái
        new Chart(document.getElementById('chartStatus'), {
            type: 'doughnut',
            data: {
                labels: ['Chờ xử lý', 'Đang làm', 'Chờ duyệt', 'Hoàn thành', 'Từ chối'],
                datasets: [{
                    data: [@Model.Pending, @Model.InProgress, @Model.PendingReview, @Model.Completed, @Model.Rejected],
                    backgroundColor: ['#fef3c7','#dbeafe','#ede9fe','#dcfce7','#fee2e2'],
                    borderColor:     ['#d97706','#2563eb','#7c3aed','#16a34a','#dc2626'],
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            font: { family: 'DM Sans', size: 13 },
                            padding: 16,
                            usePointStyle: true,
                            pointStyleWidth: 10
                        }
                    }
                },
                cutout: '65%'
            }
        });

        // Chart 2 — Đúng hạn vs quá hạn
        new Chart(document.getElementById('chartOntime'), {
            type: 'doughnut',
            data: {
                labels: ['Đúng hạn', 'Quá hạn'],
                datasets: [{
                    data: [@Model.OnTime, @Model.Overdue],
                    backgroundColor: ['#dcfce7', '#fee2e2'],
                    borderColor:     ['#16a34a', '#dc2626'],
                    borderWidth: 2,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            font: { family: 'DM Sans', size: 13 },
                            padding: 16,
                            usePointStyle: true,
                            pointStyleWidth: 10
                        }
                    }
                },
                cutout: '65%'
            }
        });

        // Chart 3 — Bar chart 7 ngày
        new Chart(document.getElementById('chartWeekly'), {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.WeeklyCompleted.Select(w => $"'{w.Label}'")))],
                datasets: [
                    {
                        label: 'Hoàn thành',
                        data: [@string.Join(",", Model.WeeklyCompleted.Select(w => w.Completed))],
                        backgroundColor: '#4f46e5',
                        borderRadius: 6,
                        borderSkipped: false,
                    },
                    {
                        label: 'Được giao',
                        data: [@string.Join(",", Model.WeeklyCompleted.Select(w => w.Assigned))],
                        backgroundColor: '#e0e7ff',
                        borderRadius: 6,
                        borderSkipped: false,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            font: { family: 'DM Sans', size: 13 },
                            usePointStyle: true,
                            pointStyleWidth: 10,
                            padding: 16
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { family: 'DM Sans', size: 13 } }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f3f4f6' },
                        ticks: {
                            font: { family: 'DM Mono', size: 12 },
                            stepSize: 1
                        }
                    }
                }
            }
        });
    </script>
}